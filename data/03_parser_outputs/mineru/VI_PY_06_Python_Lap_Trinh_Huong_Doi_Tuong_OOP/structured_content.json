          ],
          "level": 2,
          "content": "Complete Point Class"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.012,
            0.175,
            0.13,
            0.221
          ],
          "level": 2,
          "content": "diem.py"
        },
        {
          "type": "code",
          "bbox": [
            0.075,
            0.238,
            0.969,
            1.0
          ],
          "sub_type": "code",
          "content": "```python\nfrom math import *\n\nclass Diem:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def khoang_cach_tu_tam_o(self):\n        return sqrt(self.x * self.x + self.y * self.y)\n\n    def khoang_cach(self, other):\n        dx = self.x - other.x\n        dy = self.y - other.y\n        return sqrt(dx * dx + dy * dy)\n\n    def dich_chuyen(self, dx, dy):\n        self.x += dx\n        self.y += dy\n\n    def __str__(self):\n        return \"(\" + str(self.x) + \", \" + str(self.y) + \")\"\n```",
          "captions": [],
          "footnotes": []
        }
