            0.406,
            0.792,
            0.423
          ],
          "level": 2,
          "content": "Horizontal Notation"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.435,
            0.85,
            0.453
          ],
          "content": "• Want a pictoral way to visualize this sorting"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.454,
            0.778,
            0.469
          ],
          "content": "§ Represent the list as long rectangle"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.47,
            0.805,
            0.485
          ],
          "content": "§ We saw this idea in divide-and-conquer"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.519,
            0.761,
            0.535
          ],
          "content": "• Do **not** show individual boxes"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.536,
            0.778,
            0.552
          ],
          "content": "§ Just dividing lines between regions"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.553,
            0.765,
            0.569
          ],
          "content": "§ Label dividing lines with indices"
        },
        {
          "type": "text",
          "bbox": [
            0.792,
            0.547,
            0.858,
            0.561
          ],
          "content": "(h+1) – h = 1"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.569,
            0.843,
            0.586
          ],
          "content": "§ But index is either left or right of dividing line"
        },
        {
          "type": "paragraph_title",
