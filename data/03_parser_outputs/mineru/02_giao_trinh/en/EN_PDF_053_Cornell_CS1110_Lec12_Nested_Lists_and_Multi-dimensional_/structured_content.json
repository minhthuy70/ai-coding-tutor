        {
          "type": "paragraph_title",
          "bbox": [
            0.62,
            0.405,
            0.802,
            0.424
          ],
          "level": 2,
          "content": "Lists vs. Class Objects"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.464,
            0.688,
            0.479
          ],
          "content": "• Attributes are indexed"
        },
        {
          "type": "text",
          "bbox": [
            0.781,
            0.439,
            0.818,
            0.453
          ],
          "content": "**RGB**"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.48,
            0.646,
            0.493
          ],
          "content": "§ Example: x[2]"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.464,
            0.855,
            0.479
          ],
          "content": "• Attributes are named"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.479,
            0.826,
            0.585
          ],
          "content": "§ Example: c.red c **id3** id3 RGB red 128 green 64 blue 255"
        },
        {
          "type": "table",
          "bbox": [
            0.201,
            0.774,
            0.375,
            0.859
          ],
          "content": "| Type | Container? | Mutable? |\n| --- | --- | --- |\n| int | No | No |\n| float | No | No |\n| str | Yes* | No |\n| Point | Yes | Yes |\n| RGB | Yes | Yes |\n| list | Yes | Yes |",
          "captions": [],
          "footnotes": [],
