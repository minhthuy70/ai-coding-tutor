            0.546,
            0.166,
            0.709,
            0.18
          ],
          "content": "2. \"\"\" Swaps b[h] and b[k] in b"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.604,
            0.125,
            0.819,
            0.142
          ],
          "level": 2,
          "content": "Lists and Functions: Swap"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.2,
            0.686,
            0.376,
            0.704
          ],
          "level": 2,
          "content": "Lists and Expressions"
        },
        {
          "type": "text",
          "bbox": [
            0.548,
            0.154,
            0.647,
            0.167
          ],
          "content": "1. def swap(b, h, k):"
        },
        {
          "type": "text",
          "bbox": [
            0.546,
            0.179,
            0.71,
            0.192
          ],
          "content": "3. **Precond**: b is a mutable list,"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.845,
            0.186,
            0.86
          ],
          "content": "[3, 7, 11]"
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.192,
            0.703,
            0.205
          ],
          "content": "4. h, k are valid positions\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.204,
            0.638,
            0.217
          ],
          "content": "5. temp= b[h]"
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.216,
            0.635,
            0.23
          ],
          "content": "6. b[h]= b[k]"
        },
        {
          "type": "text",
          "bbox": [
            0.785,
            0.161,
            0.876,
            0.194
          ],
          "content": "Swaps b[h] and b[k], because parameter b contains name of list."
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.23,
            0.638,
            0.243
          ],
          "content": "7. b[k]= temp"
        },
