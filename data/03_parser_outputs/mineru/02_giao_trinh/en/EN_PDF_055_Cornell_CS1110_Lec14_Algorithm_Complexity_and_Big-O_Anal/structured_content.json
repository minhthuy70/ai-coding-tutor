    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.886,
            0.021,
            0.96,
            0.039
          ],
          "content": "10/4/26"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.195,
            0.124,
            0.381,
            0.143
          ],
          "level": 2,
          "content": "Shallow vs. Deep Copy"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.154,
            0.363,
            0.171
          ],
          "content": "• **Shallow copy:** Copy top-level list"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.171,
            0.404,
            0.188
          ],
          "content": "§ Happens when slice a multidimensional list"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.188,
            0.404,
            0.223
          ],
          "content": "• **Deep copy:** Copy top and all nested lists § Requires a special function: copy.deepcopy"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.224,
            0.206,
            0.24
          ],
          "content": "• **Example:**"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.24,
            0.234,
            0.256
          ],
          "content": ">>> import copy"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.255,
            0.25,
            0.27
          ],
          "content": ">>> a = [[1,2],[2,3]]"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.27,
            0.206,
            0.285
          ],
          "content": ">>> b = a[:]"
        },
        {
          "type": "text",
          "bbox": [
            0.286,
            0.27,
            0.378,
            0.286
          ],
          "content": "\\# Shallow copy"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.285,
            0.365,
            0.301
          ],
          "content": ">>> c = copy.deepcopy(a) # Deep copy"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.599,
            0.124,
            0.824,
            0.142
          ],
          "level": 2,
          "content": "Functions over Nested Lists"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.154,
            0.852,
            0.172
          ],
          "content": "• Functions on nested lists similar to lists"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.174,
            0.804,
            0.192
          ],
          "content": "§ Go over (nested) list with for-loop"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.194,
            0.824,
            0.211
          ],
          "content": "§ Use accumulator to gather the results"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.213,
            0.784,
            0.231
          ],
          "content": "• But two important differences"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.232,
            0.743,
            0.25
          ],
          "content": "§ Need **multiple for-loops**"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.251,
            0.816,
            0.269
          ],
          "content": "§ One for each part/dimension of loop"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.27,
            0.864,
            0.287
          ],
          "content": "§ In some cases need **multiple accumulators**"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.288,
            0.81,
            0.305
          ],
          "content": "§ Latter true when result is new table"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.185,
            0.406,
            0.392,
            0.423
          ],
          "level": 2,
          "content": "Functions on Nested Lists"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.118,
            0.435,
            0.209,
            0.448
          ],
          "level": 2,
          "content": "def all\\_nums(table):"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.448,
            0.337,
            0.461
          ],
          "content": "\"\"\"Returns True if table contains only numbers"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.465,
            0.335,
            0.479
          ],
          "content": "Precondition: table is a (non-ragged) 2d List\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.48,
            0.228,
            0.492
          ],
          "content": "result = True"
        },
        {
          "type": "text",
          "bbox": [
            0.129,
            0.492,
            0.226,
            0.504
          ],
          "content": "\\# Walk through table"
        },
        {
          "type": "text",
          "bbox": [
            0.237,
            0.485,
            0.32,
            0.499
          ],
          "content": "Accumulator"
        },
        {
          "type": "text",
          "bbox": [
            0.129,
            0.505,
            0.204,
            0.517
          ],
          "content": "for row in table:"
        },
        {
          "type": "text",
          "bbox": [
            0.278,
            0.506,
            0.345,
            0.52
          ],
          "content": "First Loop"
        },
        {
          "type": "text",
          "bbox": [
            0.139,
            0.518,
            0.249,
            0.53
          ],
          "content": "\\# Walk through the row"
        },
        {
          "type": "text",
          "bbox": [
            0.14,
            0.53,
            0.212,
            0.542
          ],
          "content": "for item in row:"
        },
        {
          "type": "text",
          "bbox": [
            0.269,
            0.525,
            0.353,
            0.54
          ],
          "content": "Second Loop"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.543,
            0.286,
            0.555
          ],
          "content": "if not type(item) in [int,float]:"
        },
        {
          "type": "text",
          "bbox": [
            0.161,
            0.555,
            0.229,
            0.569
          ],
          "content": "result = False"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.574,
            0.191,
            0.587
          ],
          "content": "return result"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.206,
            0.686,
            0.371,
            0.704
          ],
          "level": 2,
          "content": "A Mutable Example"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.118,
            0.715,
            0.211,
            0.728
          ],
          "level": 2,
          "content": "def add\\_ones(table):"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.728,
            0.311,
            0.74
          ],
          "content": "\"\"\"Adds one to every number in the table"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.741,
            0.274,
            0.753
          ],
          "content": "Preconditions: table is a 2d List,"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.753,
            0.254,
            0.765
          ],
          "content": "all table elements are int\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.129,
            0.765,
            0.266,
            0.777
          ],
          "content": "\\# Walk through table"
        },
        {
          "type": "text",
          "bbox": [
            0.129,
            0.778,
            0.26,
            0.791
          ],
          "content": "for rpos in range(len(table)):"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.548,
            0.627
          ],
          "content": "10"
        },
        {
          "type": "text",
          "bbox": [
            0.276,
            0.762,
            0.359,
            0.789
          ],
          "content": "Do not loop <u>over the table</u>"
        },
        {
          "type": "image",
          "bbox": [
            0.394,
            0.733,
            0.453,
            0.766
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_1_image_44.jpg"
        },
        {
