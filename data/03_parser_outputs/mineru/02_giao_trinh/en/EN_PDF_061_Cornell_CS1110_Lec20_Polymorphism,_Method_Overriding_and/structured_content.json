        },
        {
          "type": "text",
          "bbox": [
            0.372,
            0.202,
            0.424,
            0.215
          ],
          "content": "**Employee**"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.217,
            0.281,
            0.247
          ],
          "content": "• New method definitions **override** those of parent"
        },
        {
          "type": "text",
          "bbox": [
            0.353,
            0.215,
            0.424,
            0.25
          ],
          "content": "\\_init\\_\\_(self,n,d,s) \\_str\\_\\_(self) \\_eq\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.247,
            0.294,
            0.263
          ],
          "content": "§ Access to old version is **lost**"
        },
        {
          "type": "text",
          "bbox": [
            0.373,
            0.257,
            0.422,
            0.27
          ],
          "content": "**Executive**"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.264,
            0.282,
            0.278
          ],
          "content": "§ New version used instead"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.279,
            0.251,
            0.295
          ],
          "content": "§ **Example**: \\_\\_init\\_\\_"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.27,
            0.423,
            0.282
          ],
          "content": "\\_\\_init\\_\\_(self,n,d,b)"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.281,
            0.404,
            0.292
          ],
          "content": "\\_str\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.292,
            0.4,
            0.304
          ],
          "content": "\\_eq\\_\\_(self)"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.231,
            0.405,
            0.346,
            0.424
          ],
          "level": 2,
          "content": "About super()"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.434,
            0.265,
            0.45
          ],
          "content": "• super() is very limited"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.435,
            0.46,
            0.45
          ],
          "content": "• Need arguments for more"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.451,
            0.263,
            0.465
          ],
          "content": "§ Can only go one level"
        },
        {
          "type": "text",
          "bbox": [
            0.308,
            0.451,
            0.408,
            0.465
          ],
          "content": "§ super(class,self)"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.465,
            0.26,
            0.479
          ],
          "content": "§ **BAD**: super().super()"
        },
        {
          "type": "text",
          "bbox": [
            0.124,
            0.486,
            0.165,
            0.5
          ],
          "content": "p **id2**"
        },
        {
          "type": "text",
          "bbox": [
            0.309,
            0.475,
            0.381,
            0.489
          ],
          "content": "The **subclass**"
        },
        {
          "type": "text",
          "bbox": [
            0.395,
            0.469,
            0.459,
            0.495
          ],
          "content": "Object in <u>the method</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.124,
            0.514,
            0.146,
            0.525
          ],
          "content": "**id2**"
        },
        {
          "type": "text",
          "bbox": [
            0.155,
            0.525,
            0.185,
            0.536
          ],
          "content": "**Exec**"
        },
        {
          "type": "image",
          "bbox": [
            0.121,
            0.511,
            0.449,
            0.569
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_1_image_29.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.265,
            0.515,
            0.378,
            0.529
          ],
          "content": "super(Exec,self).\\_\\_str\\_\\_()"
        },
        {
          "type": "text",
          "bbox": [
            0.208,
            0.568,
            0.47,
            0.582
          ],
          "content": "p.\\_\\_str\\_\\_() super().\\_\\_str\\_\\_() super(Empl,self).\\_\\_str\\_\\_()"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.548,
            0.627
          ],
          "content": "10"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.123,
            0.686,
            0.453,
            0.704
          ],
          "level": 2,
          "content": "Instance Attributes are (Often) Inherited"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.576,
            0.124,
            0.846,
            0.142
          ],
          "level": 2,
          "content": "Accessing the “Previous” Method"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.153,
            0.709,
            0.18
          ],
          "content": "• What if you want to use the original version method?"
        },
        {
          "type": "text",
          "bbox": [
            0.723,
            0.151,
            0.81,
            0.164
          ],
          "content": "class Employee(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.163,
            0.849,
            0.176
          ],
          "content": "\"\"\"An Employee with a salary\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.18,
            0.712,
            0.194
          ],
          "content": "§ New method = original+more"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.183,
            0.802,
            0.195
          ],
          "content": "def \\_\\_str\\_\\_(self):"
        },
        {
          "type": "text",
          "bbox": [
            0.144,
            0.855,
            0.212,
            0.866
          ],
          "content": "self.\\_bonus = b"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.194,
            0.821,
            0.205
          ],
          "content": "return (self.\\_name +"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.204,
            0.871,
            0.216
          ],
          "content": "', year ' + str(self.\\_start) +"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.216,
            0.876,
            0.228
          ],
          "content": "', salary ' + str(self.\\_salary))"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.83,
            0.251,
            0.843
          ],
          "content": "def \\_\\_init\\_\\_(self,n,d,b=0.0):"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.194,
            0.701,
            0.217
          ],
          "content": "§ Do not want to repeat code from the original version"
        },
        {
          "type": "text",
          "bbox": [
            0.124,
            0.715,
            0.222,
            0.727
          ],
          "content": "class Employee(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.217,
            0.692,
            0.231
          ],
          "content": "• Use the function super()"
        },
        {
          "type": "text",
          "bbox": [
            0.808,
            0.433,
            0.845,
            0.445
          ],
          "content": "**object**"
        },
        {
          "type": "text",
          "bbox": [
            0.144,
            0.844,
            0.236,
            0.855
          ],
          "content": "super().\\_\\_init\\_\\_(n,d)"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.736,
            0.272,
            0.786
          ],
          "content": "def \\_\\_init\\_\\_(self,n,d,s=50000.0): self.\\_name = n self.\\_start = d self.\\_salary = s"
        },
        {
          "type": "text",
          "bbox": [
            0.722,
            0.236,
            0.825,
            0.248
          ],
          "content": "class Executive(Employee):"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.232,
            0.718,
            0.245
          ],
          "content": "§ “Converts” type to parent class"
        },
        {
          "type": "text",
          "bbox": [
            0.401,
            0.821,
            0.453,
            0.853
          ],
          "content": "Created in **Executive** initializer"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.578,
            0.406,
            0.844,
            0.424
          ],
          "level": 2,
          "content": "Primary Application: Initializers"
        },
        {
          "type": "text",
          "bbox": [
            0.764,
            0.445,
            0.815,
            0.456
          ],
          "content": "\\_init\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.317,
            0.808,
            0.378,
            0.821
          ],
          "content": "\\_bonus 0.0"
        },
        {
          "type": "text",
          "bbox": [
            0.125,
            0.808,
            0.239,
            0.821
          ],
          "content": "class Executive(Employee):"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.245,
            0.709,
            0.258
          ],
          "content": "§ Now methods go to the class"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.247,
            0.851,
            0.259
          ],
          "content": "\"\"\"An Employee with a bonus.\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.764,
            0.455,
            0.814,
            0.466
          ],
          "content": "\\_str\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.406,
            0.748,
            0.458,
            0.781
          ],
          "content": "Created in **Employee** initializer"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.466,
            0.811,
            0.478
          ],
          "continues_prev": true,
          "content": "\\_eq\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.548,
            0.435,
            0.645,
            0.447
          ],
          "content": "class Employee(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.796,
            0.484,
            0.847,
            0.496
          ],
          "content": "**Employee**"
        },
        {
          "type": "text",
          "bbox": [
            0.319,
            0.749,
            0.383,
            0.763
          ],
          "content": "name 'Fred'"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.332,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.457,
            0.695,
            0.47
          ],
          "content": "def \\_\\_init\\_\\_(self,n,d,s=50000.0):"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.497,
            0.835,
            0.508
          ],
          "content": "\\_init\\_\\_(self,n,d,s)"
        },
        {
          "type": "text",
          "bbox": [
            0.316,
            0.766,
            0.382,
            0.78
          ],
          "content": "\\_start 2012"
        },
        {
          "type": "text",
          "bbox": [
            0.765,
            0.508,
            0.814,
            0.518
          ],
          "content": "\\_str\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.259,
            0.668,
            0.286
          ],
          "content": "• **Example**: super().\\_\\_str\\_\\_()"
        },
        {
          "type": "text",
          "bbox": [
            0.568,
            0.471,
            0.633,
            0.482
          ],
          "content": "self.\\_name = n"
        },
        {
          "type": "text",
          "bbox": [
            0.568,
            0.494,
            0.635,
            0.505
          ],
          "content": "self.\\_salary = s"
        },
        {
          "type": "text",
          "bbox": [
            0.319,
            0.783,
            0.386,
            0.796
          ],
          "content": "\\_salary 50000.0"
        },
        {
          "type": "text",
          "bbox": [
            0.568,
            0.483,
            0.632,
            0.493
          ],
          "content": "self.\\_start = d"
        },
        {
          "type": "text",
          "bbox": [
            0.582,
            0.288,
            0.646,
            0.308
          ],
          "content": "**In Python 2** <strong><u>self goes here</u></strong>"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.266,
            0.8,
            0.279
          ],
          "continues_prev": true,
          "content": "def \\_\\_str\\_\\_(self):"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.519,
            0.811,
            0.531
          ],
          "content": "\\_eq\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.279,
            0.839,
            0.29
          ],
          "content": "return (super().\\_\\_str\\_\\_()"
        },
        {
          "type": "text",
          "bbox": [
            0.765,
            0.288,
            0.882,
            0.3
          ],
          "content": "\\+ ', bonus ' + str(self.\\_bonus) )"
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.528,
            0.662,
            0.541
          ],
          "content": "class Executive(Employee):"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.548,
            0.676,
            0.586
          ],
          "content": "def \\_\\_init\\_\\_(self,n,d,b=0.0): super().\\_\\_init\\_\\_(n,d) self.\\_bonus = b"
        },
        {
          "type": "text",
          "bbox": [
            0.796,
            0.539,
            0.847,
            0.551
          ],
          "content": "**Executive**"
        },
        {
          "type": "text",
          "bbox": [
            0.758,
            0.551,
            0.839,
            0.585
          ],
          "content": "\\_init\\_\\_(self,n,d,b) \\_str\\_\\_(self) \\_eq\\_\\_(self)"
        },
        {
          "type": "text",
          "bbox": [
            0.319,
            0.72,
            0.34,
            0.732
          ],
          "content": "**id4**"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.731,
            0.405,
            0.743
          ],
          "content": "**Executive**"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.573,
            0.686,
            0.849,
            0.704
          ],
          "level": 2,
          "content": "Also Works With Class Attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.72,
            0.865,
            0.735
          ],
          "content": "**Class Attribute**: Assigned outside of any method definition"
        },
        {
          "type": "text",
          "bbox": [
            0.554,
            0.753,
            0.699,
            0.801
          ],
          "content": "class Employee(object): \"\"\"Instance is salaried worker\"\"\" # Class Attribute STD\\_SALARY = 50000.0"
        },
        {
          "type": "text",
          "bbox": [
            0.814,
            0.748,
            0.851,
            0.761
          ],
          "content": "**object**"
        },
        {
          "type": "text",
          "bbox": [
            0.802,
            0.786,
            0.852,
            0.799
          ],
          "content": "**Employee**"
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.811,
            0.668,
            0.823
          ],
          "content": "class Executive(Employee):"
        },
        {
          "type": "text",
          "bbox": [
            0.737,
            0.805,
            0.846,
            0.818
          ],
          "content": "STD\\_SALARY 50000.0"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.823,
            0.696,
            0.835
          ],
          "content": "\"\"\"An Employee with a bonus.\"\"”"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.835,
            0.639,
            0.846
          ],
          "content": "\\# Class Attribute"
        },
        {
          "type": "text",
          "bbox": [
            0.803,
            0.831,
            0.852,
            0.844
          ],
          "content": "**Executive**"
        },
        {
          "type": "text",
          "bbox": [
            0.562,
            0.846,
            0.663,
            0.859
          ],
          "content": "STD\\_BONUS = 10000.0"
        },
        {
          "type": "text",
          "bbox": [
            0.737,
            0.849,
            0.844,
            0.863
          ],
          "content": "STD\\_BONUS 10000.0"
        },
        {
