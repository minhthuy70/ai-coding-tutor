          ],
          "level": 2,
          "content": "Approaching Complex Input"
        },
        {
          "type": "text",
          "bbox": [
            0.038,
            0.205,
            0.534,
            0.266
          ],
          "content": "• Look at what you need…"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.287,
            0.657,
            0.339
          ],
          "content": "§ From the current animation frame"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.36,
            0.68,
            0.417
          ],
          "content": "§ From the previous animation frame"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.435,
            0.598,
            0.493
          ],
          "content": "§ From many frames in the past"
        },
        {
          "type": "text",
          "bbox": [
            0.752,
            0.377,
            0.93,
            0.474
          ],
          "content": "Requires new attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.038,
            0.514,
            0.615,
            0.573
          ],
          "content": "• **Previous frame** is the easiest"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.595,
            0.732,
            0.65
          ],
          "content": "§ Set them at the end of update() method"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.671,
            0.656,
            0.729
