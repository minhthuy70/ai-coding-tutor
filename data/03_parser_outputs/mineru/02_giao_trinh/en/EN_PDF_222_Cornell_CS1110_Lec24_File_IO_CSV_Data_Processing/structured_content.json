        {
          "type": "text",
          "bbox": [
            0.064,
            0.737,
            0.372,
            0.85
          ],
          "content": "Responds to the controller requests"
        },
        {
          "type": "text",
          "bbox": [
            0.421,
            0.239,
            0.595,
            0.299
          ],
