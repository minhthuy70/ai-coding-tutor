    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.147,
            0.067,
            0.851,
            0.139
          ],
          "level": 2,
          "content": "Designing Complex Applications"
        },
        {
          "type": "text",
          "bbox": [
            0.038,
            0.205,
            0.477,
            0.331
          ],
          "content": "• Applications can become extremely complex"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.349,
            0.46,
            0.4
          ],
          "content": "§ Large classes doing a lot"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.419,
            0.463,
            0.468
          ],
          "content": "§ Many states & invariants"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.487,
            0.459,
            0.538
          ],
          "content": "§ Specification unreadable"
        },
        {
          "type": "text",
          "bbox": [
            0.039,
            0.562,
            0.453,
            0.687
          ],
          "content": "• **Idea**: Break application up into several classes"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.706,
            0.46,
            0.753
          ],
          "content": "§ Start with a “main” class"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.777,
            0.451,
            0.824
          ],
          "content": "§ Other classes have roles"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.845,
            0.481,
            0.894
          ],
          "content": "§ Main class delegates work"
        },
        {
          "type": "text",
          "bbox": [
            0.525,
            0.291,
            0.683,
            0.352
          ],
          "content": "MainApp"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.26,
            0.962,
            0.313
          ],
          "content": "§ Processes input"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.329,
            0.977,
            0.378
          ],
          "content": "§ Determines state"
        },
        {
          "type": "text",
          "bbox": [
            0.623,
            0.445,
            0.91,
            0.496
          ],
          "content": "Calls the methods of"
        },
        {
          "type": "text",
          "bbox": [
            0.517,
            0.616,
            0.691,
            0.669
          ],
          "content": "Animation"
        },
        {
          "type": "text",
          "bbox": [
            0.717,
            0.619,
            0.97,
            0.671
          ],
          "content": "§ Animates (only)"
        },
        {
          "type": "text",
          "bbox": [
            0.628,
            0.794,
            0.898,
            0.845
          ],
          "content": "See subcontroller.py"
        }
      ]
    },
    {
