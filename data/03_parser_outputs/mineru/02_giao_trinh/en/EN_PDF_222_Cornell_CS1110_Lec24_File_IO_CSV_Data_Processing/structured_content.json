          "level": 2,
          "content": "Checking Input"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.175,
            0.22,
            0.349,
            0.279
          ],
          "level": 2,
          "content": "Keyboard"
        },
        {
          "type": "index",
          "bbox": [
            0.029,
            0.305,
            0.949,
            0.904
          ],
          "content": "- - is\\_key\\_down(key)\n- - Returns True if key is down\n- - key is a string ('a' or 'space')\n- - Empty string means any key\n- - is\\_key\\_pressed(key)\n- - Returns True if key pressed\n- - key not down prev. frame\n- - is\\_key\\_released(key)\n- - Returns True if key released\n- - key was down prev. frame\n- - touch\n- - **Attribute** giving a position\n- - Stored as a Point2 object\n- - But None if no touch\n- - is\\_touch\\_pressed()\n- - True if touch pressed\n- - touch was None prev. frame\n- - is\\_touch\\_released()\n- - True if touch released\n- - touch not None prev. frame"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.62,
            0.219,
            0.853,
            0.275
          ],
          "level": 2,
          "content": "Mouse/Touch"
        }
      ]
    },
    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.226,
            0.067,
            0.771,
            0.137
          ],
          "level": 2,
          "content": "Programming Animation"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.153,
            0.222,
            0.37,
            0.273
          ],
          "level": 2,
          "content": "Intra-Frame"
        },
        {
          "type": "text",
          "bbox": [
            0.038,
            0.333,
            0.468,
            0.387
          ],
          "content": "• Computation within frame"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.402,
            0.456,
            0.452
          ],
          "content": "§ Only need current frame"
        },
        {
          "type": "text",
          "bbox": [
            0.04,
            0.468,
            0.39,
            0.521
          ],
          "content": "• **Example:** Collisions"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.536,
            0.419,
            0.585
          ],
          "content": "§ Need current position"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.6,
            0.456,
            0.65
          ],
          "content": "§ Use to check for overlap"
        },
        {
          "type": "text",
          "bbox": [
            0.04,
            0.667,
            0.431,
            0.716
          ],
          "content": "• Can use **local variables**"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.732,
            0.433,
            0.781
          ],
          "content": "§ All lost at update() end"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.797,
            0.458,
            0.846
          ],
          "content": "§ But no longer need them"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.63,
            0.221,
            0.845,
            0.273
          ],
          "level": 2,
          "content": "Inter-Frame"
        },
        {
          "type": "text",
          "bbox": [
            0.514,
            0.334,
            0.956,
            0.388
          ],
          "content": "• Computation across frames"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.402,
            0.963,
            0.451
          ],
          "content": "§ Use values from last frame"
        },
        {
          "type": "text",
          "bbox": [
            0.515,
            0.469,
            0.875,
            0.521
          ],
          "content": "• **Example:** Movement"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.535,
            0.957,
            0.587
          ],
          "content": "§ Need old position/velocity"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.601,
            0.908,
            0.651
          ],
          "content": "§ Compute next position"
        },
        {
          "type": "text",
          "bbox": [
            0.515,
            0.666,
            0.848,
            0.719
          ],
          "content": "• Requires **attributes**"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.733,
            0.923,
            0.782
          ],
          "content": "§ Attributes never deleted"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.796,
            0.962,
            0.846
          ],
          "content": "§ Remain after update() ends"
        }
      ]
    },
    {
      "page_idx": 2,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.147,
            0.067,
            0.85,
            0.135
          ],
          "level": 2,
          "content": "Interframe Computation: Touch"
        },
        {
          "type": "text",
          "bbox": [
            0.038,
            0.2,
            0.469,
            0.249
          ],
          "content": "• Works like an Etch-a-Sketch"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.265,
            0.422,
            0.312
          ],
          "content": "§ User draws by touching"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.325,
            0.469,
            0.372
          ],
          "content": "§ Checks position each frame"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.387,
            0.484,
            0.432
          ],
          "content": "§ Draws lines between touches"
        },
        {
          "type": "text",
          "bbox": [
            0.039,
            0.451,
            0.478,
            0.499
          ],
          "content": "• Uses attribute touch in GInput"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.515,
            0.442,
            0.562
          ],
          "content": "§ The mouse press position"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.575,
            0.411,
            0.622
          ],
          "content": "§ Or **None** if not pressed"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.637,
            0.466,
            0.683
          ],
          "content": "§ Access with self.input.touch"
        },
        {
          "type": "text",
          "bbox": [
            0.039,
            0.701,
            0.46,
            0.749
          ],
          "content": "• But we also need last touch!"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.765,
            0.459,
            0.811
          ],
          "content": "§ Forgot if we do not store it"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.825,
            0.422,
            0.873
          ],
          "content": "§ Purpose of attribute last"
        },
        {
          "type": "text",
          "bbox": [
            0.587,
            0.221,
            0.92,
            0.276
          ],
          "content": "Line segment = 2 points"
        },
        {
          "type": "text",
          "bbox": [
            0.58,
            0.414,
            0.675,
            0.501
          ],
          "content": "Current Touch"
        },
        {
          "type": "text",
          "bbox": [
            0.706,
            0.553,
            0.813,
            0.643
          ],
          "content": "Previous Touch"
        },
        {
          "type": "text",
          "bbox": [
            0.673,
            0.767,
            0.848,
            0.819
          ],
          "content": "See touch.py"
        }
      ]
    },
    {
      "page_idx": 3,
      "blocks": [
        {
          "type": "paragraph_title",
          "bbox": [
            0.193,
            0.067,
            0.806,
            0.139
          ],
          "level": 2,
          "content": "Complex Input: Click Types"
        },
        {
          "type": "text",
          "bbox": [
            0.037,
            0.201,
            0.512,
            0.257
          ],
          "content": "• Double click = 2 fast clicks"
        },
        {
          "type": "text",
          "bbox": [
            0.037,
            0.276,
            0.517,
            0.331
          ],
          "content": "• Count number of fast clicks"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.349,
            0.427,
            0.397
          ],
          "content": "§ Add an attribute clicks"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.418,
            0.504,
            0.47
          ],
          "content": "§ Reset to 0 if not fast enough"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.038,
            0.49,
            0.352,
            0.549
          ],
          "level": 2,
          "content": "• Time click speed"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.563,
            0.411,
            0.612
          ],
          "content": "§ Add an attribute time"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.631,
            0.524,
            0.682
          ],
          "content": "§ Set to 0 when mouse released"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.703,
            0.525,
            0.813
          ],
          "content": "§ Increment when not pressed (e.g. in loop method update())"
        },
        {
          "type": "text",
          "bbox": [
            0.088,
            0.829,
            0.534,
            0.881
          ],
          "content": "§ Check time when next pressed"
        },
        {
          "type": "text",
          "bbox": [
            0.62,
            0.244,
            0.898,
            0.305
          ],
          "content": "Is it fast enough?"
        },
        {
          "type": "image",
          "bbox": [
