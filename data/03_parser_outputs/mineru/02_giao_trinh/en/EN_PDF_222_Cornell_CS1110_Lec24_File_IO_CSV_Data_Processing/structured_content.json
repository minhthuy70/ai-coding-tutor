          "type": "text",
          "bbox": [
            0.345,
            0.312,
            0.651,
            0.425
          ],
          "content": "Updates model in response to events"
        },
        {
          "type": "text",
          "bbox": [
            0.344,
            0.43,
            0.655,
            0.544
          ],
          "content": "Updates view with model changes"
        },
        {
          "type": "text",
          "bbox": [
            0.755,
            0.195,
            0.931,
            0.359
          ],
          "content": "Calls the methods or functions of"
        },
        {
          "type": "text",
          "bbox": [
            0.752,
            0.545,
            0.847,
            0.605
          ],
          "content": "<u>View</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.637,
            0.621,
            0.955,
            0.733
          ],
          "content": "Displays the model to the app user"
        },
        {
          "type": "text",
          "bbox": [
            0.637,
            0.745,
            0.956,
            0.857
          ],
          "content": "Provides user input to the controller"
