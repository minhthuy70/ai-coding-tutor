        },
        {
          "type": "text",
          "bbox": [
            0.086,
            0.284,
            0.42,
            0.323
          ],
          "content": "while &lt;condition&gt;:"
        },
        {
          "type": "text",
          "bbox": [
            0.159,
            0.339,
            0.388,
            0.38
          ],
          "content": "&lt;expression&gt;"
        },
        {
          "type": "text",
          "bbox": [
            0.159,
            0.393,
            0.388,
            0.435
          ],
          "content": "&lt;expression&gt;"
        },
        {
          "type": "text",
          "bbox": [
            0.086,
            0.51,
            0.662,
            0.555
          ],
          "content": "&lt;condition&gt; evaluates to a Boolean"
        },
        {
          "type": "text",
          "bbox": [
            0.086,
            0.578,
            0.85,
            0.665
          ],
          "content": "if &lt;condition&gt; is True, do all the steps inside the while code block"
        },
        {
          "type": "text",
          "bbox": [
            0.087,
            0.689,
            0.513,
            0.735
          ],
          "content": "check &lt;condition&gt; again"
        },
        {
          "type": "text",
          "bbox": [
            0.086,
            0.759,
            0.648,
            0.804
          ],
          "content": "repeat until &lt;condition&gt; is False"
        },
        {
