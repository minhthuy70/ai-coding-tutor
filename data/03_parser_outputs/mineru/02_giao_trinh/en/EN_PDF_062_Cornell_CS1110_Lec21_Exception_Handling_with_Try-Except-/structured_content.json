          ],
          "content": "bot= self.\\_denominator\\*q.\\_denominator"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.614,
            0.539,
            0.627
          ],
          "content": "4"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.825,
            0.707,
            0.838
          ],
          "content": "top= (self.\\_numerator\\*q.\\_denominator+"
        },
        {
          "type": "text",
          "bbox": [
            0.578,
            0.836,
            0.706,
            0.848
          ],
