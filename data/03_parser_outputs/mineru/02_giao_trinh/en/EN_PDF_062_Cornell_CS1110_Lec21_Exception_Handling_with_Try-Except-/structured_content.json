        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.198,
            0.124,
            0.378,
            0.142
          ],
          "level": 2,
          "content": "Case Study: Fractions"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.154,
            0.274,
            0.169
          ],
          "content": "• Want to add a new **type**"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.152,
            0.403,
            0.166
          ],
          "content": "class Fraction(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.17,
            0.284,
            0.185
          ],
          "content": "§ Values are fractions: ½, ¾"
        },
        {
          "type": "text",
          "bbox": [
            0.302,
            0.166,
            0.456,
            0.18
          ],
          "content": "\"\"\"Instance is a fraction n/d\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.18,
            0.44,
            0.194
          ],
          "content": "\\# INSTANCE ATTRIBUTES:"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.185,
            0.271,
            0.213
          ],
          "content": "§ Operations are standard multiply, divide, etc."
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.195,
            0.422,
            0.209
          ],
          "content": "\\# \\_numerator: an int"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.213,
            0.256,
            0.228
          ],
          "content": "§ **Example**: $1/2^{*3}/4 = 3/8$"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.209,
            0.44,
            0.223
          ],
          "content": "\\# \\_denominator: an int > 0"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.23,
            0.275,
            0.245
          ],
          "content": "• Can do this with a class"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.245,
            0.286,
            0.26
          ],
          "content": "§ Values are fraction objects"
        },
        {
          "type": "text",
          "bbox": [
            0.303,
            0.234,
            0.439,
            0.248
          ],
          "content": "def \\_\\_init\\_\\_(self,n=0,d=1):"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.261,
            0.272,
            0.276
          ],
          "content": "§ Operations are methods"
        },
        {
          "type": "text",
          "bbox": [
            0.315,
            0.248,
            0.451,
            0.262
          ],
          "content": "\"\"\"Init: makes a Fraction\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.277,
            0.246,
            0.295
          ],
          "content": "• **Example**: frac1.py"
        },
        {
          "type": "text",
          "bbox": [
            0.315,
            0.263,
            0.418,
            0.276
          ],
          "content": "self.\\_numerator = n"
        },
        {
          "type": "text",
          "bbox": [
            0.316,
            0.276,
            0.427,
            0.291
          ],
          "content": "self.\\_denominator = d"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.572,
            0.123,
            0.849,
            0.143
          ],
          "level": 2,
          "content": "Problem: Doing Math is Unwieldy"
        },
        {
          "type": "text",
          "bbox": [
            0.571,
            0.156,
            0.678,
            0.173
          ],
          "content": "**What We Want**"
        },
        {
          "type": "equation",
          "bbox": [
            0.568,
            0.18,
            0.686,
            0.215
          ],
          "content": "\\left(\\frac {1}{2} + \\frac {1}{3} + \\frac {1}{4}\\right) * \\frac {5}{4}",
          "image_source": "images/page_0_equation_22.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.752,
            0.156,
            0.846,
            0.173
          ],
          "content": "**What We Get**"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.331,
            0.539,
            0.346
          ],
          "content": "2"
        },
        {
          "type": "text",
          "bbox": [
            0.565,
            0.233,
            0.684,
            0.284
          ],
          "content": "Why not use the standard Python math operations?"
        },
        {
          "type": "text",
          "bbox": [
            0.713,
            0.18,
            0.842,
            0.197
          ],
          "continues_prev": true,
          "content": ">>> p = Fraction(1,2)"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.197,
            0.841,
            0.214
          ],
          "content": ">>> q = Fraction(1,3)"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.214,
            0.841,
            0.23
          ],
          "content": ">>> r = Fraction(1,4)"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.23,
            0.841,
            0.245
          ],
          "content": ">>> s = Fraction(5,4)"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.246,
            0.882,
            0.263
          ],
          "content": ">>> (p.add(q.add(r))).mult(s)"
        },
        {
          "type": "text",
          "bbox": [
            0.761,
            0.276,
            0.87,
            0.294
          ],
          "content": "This is confusing!"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.196,
            0.406,
            0.38,
            0.424
          ],
          "level": 2,
          "content": "Operator Overloading"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.435,
            0.429,
            0.469
          ],
          "content": "• Many operators in Python a special symbols § +, -, /, \\*, \\*\\* for mathematics"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.47,
            0.312,
            0.485
          ],
          "content": "==, !=, <, > for comparisons"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.486,
            0.449,
            0.504
          ],
          "content": "• The meaning of these symbols depends on type"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.504,
            0.286,
            0.519
          ],
          "content": "§ 1 + 2 vs 'Hello' + 'World'"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.52,
            0.286,
            0.535
          ],
          "content": "§ 1 < 2 vs 'Hello' < 'World'"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.537,
            0.445,
            0.555
          ],
          "content": "• Our new type might want to use these symbols"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.555,
            0.402,
            0.573
          ],
          "content": "§ We overload them to support our new type"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.618,
            0.405,
            0.805,
            0.424
          ],
          "level": 2,
          "content": "Returning to Fractions"
        },
        {
          "type": "text",
          "bbox": [
            0.572,
            0.438,
            0.677,
            0.455
          ],
          "content": "**What We Want**"
        },
        {
          "type": "equation",
          "bbox": [
            0.574,
            0.461,
            0.679,
            0.493
          ],
          "content": "\\left(\\frac {1}{2} + \\frac {1}{3} + \\frac {1}{4}\\right) * \\frac {5}{4}",
          "image_source": "images/page_0_equation_42.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.565,
            0.515,
            0.684,
            0.565
          ],
          "content": "Why not use the standard Python math operations?"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.727,
            0.439,
            0.872,
            0.455
          ],
          "level": 2,
          "content": "Operator Overloading"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.463,
            0.863,
            0.489
          ],
          "content": "• Python has methods that correspond to built-in ops"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.489,
            0.865,
            0.502
          ],
          "content": "§ \\_\\_add\\_\\_ corresponds to +"
        },
        {
          "type": "text",
          "bbox": [
            0.733,
            0.502,
            0.866,
            0.515
          ],
          "content": "§ \\_\\_mul\\_\\_ corresponds to \\*"
        },
        {
          "type": "text",
          "bbox": [
            0.733,
            0.515,
            0.871,
            0.528
          ],
          "content": "§ \\_\\_eq\\_\\_ corresponds to =="
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.528,
            0.878,
            0.541
          ],
          "content": "§ Not implemented by default"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.541,
            0.868,
            0.567
          ],
          "content": "• To overload operators you implement these methods"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.613,
            0.116,
            0.627
          ],
          "content": "3"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.135,
            0.686,
            0.441,
            0.705
          ],
          "level": 2,
          "content": "Operator Overloading: Multiplication"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.117,
            0.713,
            0.202,
            0.725
          ],
          "level": 2,
          "content": "class Fraction(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.125,
            0.725,
            0.241,
            0.737
          ],
          "content": "\"\"\"Instance is a fraction n/d\"\"\""
        },
        {
          "type": "equation",
          "bbox": [
            0.291,
            0.714,
            0.401,
            0.729
          ],
          "content": "> > > \\mathrm{p} = \\text {Fraction} (1, 2)",
          "image_source": "images/page_0_equation_55.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.126,
            0.736,
            0.215,
            0.747
          ],
          "content": "\\# \\_numerator: an int"
        },
        {
          "type": "equation",
          "bbox": [
            0.291,
            0.729,
            0.401,
            0.742
          ],
          "content": "> > > \\mathrm{q} = \\text {Fraction} (3, 4)",
          "image_source": "images/page_0_equation_57.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.126,
            0.745,
            0.232,
            0.757
          ],
          "content": "\\# \\_denominator: an int > 0"
        },
        {
          "type": "equation",
          "bbox": [
            0.292,
            0.743,
            0.355,
            0.755
          ],
          "content": "> > > \\mathrm{r} = \\mathrm{p} ^ {*} \\mathrm{q}",
          "image_source": "images/page_0_equation_59.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.126,
            0.762,
            0.204,
            0.775
          ],
          "level": 2,
          "content": "def \\_\\_mul\\_\\_(self,q):"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.773,
            0.244,
            0.784
          ],
          "content": "\"\"\"Returns: Product of self, q"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.783,
            0.254,
            0.795
          ],
          "content": "Makes a new Fraction; does not"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.794,
            0.241,
            0.805
          ],
          "content": "modify contents of self or q"
        },
        {
          "type": "image",
          "bbox": [
            0.337,
            0.757,
            0.386,
            0.795
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_0_image_64.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.389,
            0.764,
            0.44,
            0.786
          ],
          "content": "Python converts to"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.805,
            0.242,
            0.816
          ],
          "content": "Precondition: q a Fraction\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.815,
            0.236,
            0.826
          ],
          "content": "assert type(q) == Fraction"
        },
        {
          "type": "equation",
          "bbox": [
            0.291,
            0.798,
            0.401,
            0.812
          ],
          "content": "\\ggg \\mathrm{r} = \\mathrm{p._mul_(q)}",
          "image_source": "images/page_0_equation_68.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.825,
            0.271,
            0.837
          ],
          "content": "top= self.\\_numerator\\*q.\\_numerator"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.837,
            0.284,
            0.848
          ],
          "content": "bot= self.\\_denominator\\*q.\\_denominator"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.847,
            0.229,
            0.859
          ],
          "content": "return Fraction(top,bot)"
        },
        {
          "type": "text",
          "bbox": [
            0.307,
            0.821,
            0.444,
            0.849
          ],
          "content": "Operator overloading uses method in object on left."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.579,
            0.686,
            0.842,
            0.705
          ],
          "level": 2,
          "content": "Operator Overloading: Addition"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.539,
            0.714,
            0.625,
            0.725
          ],
          "level": 2,
          "content": "class Fraction(object):"
        },
        {
          "type": "equation",
          "bbox": [
            0.715,
            0.715,
            0.824,
            0.728
          ],
          "content": "> > > \\mathrm{p} = \\text {Fraction} (1, 2)",
          "image_source": "images/page_0_equation_75.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.549,
            0.725,
            0.665,
            0.737
          ],
          "content": "\"'Instance is a fraction n/d'\""
        },
        {
          "type": "equation",
          "bbox": [
            0.715,
            0.729,
            0.824,
            0.742
          ],
          "content": "> > > \\mathrm{q} = \\text {Fraction} (3, 4)",
          "image_source": "images/page_0_equation_77.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.549,
            0.736,
            0.639,
            0.747
          ],
          "content": "\\# \\_numerator:  an int"
        },
        {
          "type": "text",
          "bbox": [
            0.549,
            0.745,
            0.656,
            0.757
          ],
          "content": "\\# \\_denominator: an int > 0"
        },
        {
          "type": "equation",
          "bbox": [
            0.715,
            0.743,
            0.778,
            0.755
          ],
          "content": "> > > \\mathrm{r} = \\mathrm{p} + \\mathrm{q}",
          "image_source": "images/page_0_equation_80.jpg"
        },
        {
          "type": "equation",
          "bbox": [
            0.55,
            0.763,
            0.627,
            0.775
          ],
          "content": "\\text {def \\_ add \\_ (self,q):}",
          "image_source": "images/page_0_equation_81.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.559,
            0.774,
            0.656,
            0.785
          ],
          "content": "\"\"\"Returns: Sum of self, q"
        },
        {
          "type": "text",
          "bbox": [
            0.559,
            0.783,
            0.644,
            0.795
          ],
          "content": "Makes a new Fraction"
        },
        {
          "type": "image",
          "bbox": [
            0.76,
            0.757,
            0.809,
            0.794
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_0_image_84.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.812,
            0.764,
            0.864,
            0.787
          ],
          "content": "Python converts to"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.793,
            0.666,
            0.805
          ],
          "content": "Precondition: q a Fraction\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.805,
            0.66,
            0.817
          ],
          "content": "assert type(q) == Fraction"
        },
        {
          "type": "equation",
          "bbox": [
            0.715,
            0.798,
            0.823,
            0.812
          ],
          "content": "\\ggg \\mathrm{r} = \\mathrm{p._add} (\\mathrm{q})",
          "image_source": "images/page_0_equation_88.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.815,
            0.707,
