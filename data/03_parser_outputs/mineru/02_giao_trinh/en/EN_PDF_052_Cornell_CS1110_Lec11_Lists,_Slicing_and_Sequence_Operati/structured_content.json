        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.588,
            0.405,
            0.834,
            0.425
          ],
          "level": 2,
          "content": "This Makes Debugging Tricky"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.435,
            0.861,
            0.453
          ],
          "content": "• Place error is detected != place error occurred"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.455,
            0.782,
            0.47
          ],
          "content": "§ It can be further up in the call stack"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.472,
            0.793,
            0.488
          ],
          "content": "§ It can even happen earlier in the code"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.49,
            0.808,
            0.506
          ],
          "content": "§ Error messages are not enough to debug"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.509,
            0.865,
            0.526
          ],
          "content": "• Debugging requires “**stepping-through**” code"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.614,
            0.115,
            0.627
          ],
          "content": "3"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.527,
            0.831,
            0.543
          ],
          "content": "§ You execute each line of code in your mind"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.545,
            0.835,
            0.561
          ],
          "content": "§ You determine what Python does at that step"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.563,
            0.824,
            0.58
          ],
          "content": "§ You verify that the two match (if not, bug)"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.619,
            0.686,
            0.804,
            0.704
          ],
          "level": 2,
          "content": "Case Study: Romanize"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.716,
            0.875,
            0.733
          ],
          "content": "• Roman Numerals use letters instead of numbers"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.734,
            0.816,
            0.749
          ],
          "content": "§ I = 1, V = 5, X = 10, L = 50, and C = 100"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.75,
            0.819,
            0.766
          ],
          "content": "§ Can go higher, but will stop there for now"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.767,
            0.819,
            0.784
          ],
          "content": "• Create other numbers by concatenation"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.785,
            0.655,
            0.8
          ],
          "content": "§ II = 2, III = 3"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.8,
            0.697,
            0.815
          ],
          "content": "§ LV = 55, LVIII = 53"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.818,
            0.851,
            0.835
          ],
          "content": "• If a smaller number comes first, we subtract"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.836,
            0.661,
            0.851
          ],
          "content": "§ IV = 4, IX = 9"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.852,
            0.702,
            0.868
          ],
          "content": "§ VL = 40, XCVL = 94"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.894,
            0.116,
            0.907
          ],
          "content": "5"
        },
