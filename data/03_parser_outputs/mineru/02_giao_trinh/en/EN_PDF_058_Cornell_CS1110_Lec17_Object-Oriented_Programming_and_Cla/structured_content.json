          ],
          "content": "10/21/26"
        },
        {
          "type": "page_number",
          "bbox": [
            0.103,
            0.332,
            0.115,
            0.345
          ],
          "content": "1"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.22,
            0.124,
            0.356,
            0.143
          ],
          "level": 2,
          "content": "Key-Value Pairs"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.154,
            0.406,
            0.171
          ],
          "content": "• The last built-in type: dictionary (or dict)"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.172,
            0.399,
            0.188
          ],
          "content": "§ One of the most important in all of Python"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.188,
            0.376,
            0.205
          ],
          "content": "§ Like a list, but built of key-value pairs"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.205,
            0.304,
            0.222
          ],
          "content": "• **Keys:** Unique identifiers"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.223,
            0.326,
            0.239
          ],
          "content": "§ Think social security number"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.239,
            0.333,
            0.255
          ],
          "content": "§ At Cornell we have netids: jrs1"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.613,
            0.116,
            0.628
          ],
          "content": "3"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.256,
            0.37,
            0.273
          ],
          "content": "• **Values:** Non-unique Python values"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.274,
            0.321,
            0.29
          ],
          "content": "§ John Smith (class ’13) is jrs1"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.29,
            0.321,
            0.307
          ],
          "content": "§ John Smith (class ’16) is jrs2"
        },
        {
          "type": "text",
          "bbox": [
            0.353,
            0.275,
            0.43,
            0.289
          ],
          "content": "**Idea:** Lookup"
        },
        {
          "type": "text",
          "bbox": [
            0.351,
            0.289,
            0.43,
            0.302
          ],
          "content": "values by keys"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.168,
            0.405,
            0.408,
            0.425
          ],
          "level": 2,
          "content": "Using Dictionaries (Type dict)"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.435,
            0.262,
            0.45
          ],
          "content": "• Access elts. like a list"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.45,
            0.262,
            0.465
          ],
          "content": "§ d['jrs1'] evals to 'John’"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.465,
            0.235,
            0.478
          ],
          "content": "§ d['jrs2'] does too"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.434,
            0.447,
            0.464
          ],
          "continues_prev": true,
          "content": "d = {'js1':'John','js2':'John', 'wmw2':'Walker'}"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.478,
            0.282,
            0.492
          ],
          "content": "§ d['wmw2'] evals to 'Walker'"
        },
        {
          "type": "text",
          "bbox": [
            0.343,
            0.473,
            0.365,
            0.486
          ],
          "content": "**id8**"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.492,
            0.251,
            0.506
          ],
          "content": "§ d['abc1'] is an **error**"
        },
        {
          "type": "text",
          "bbox": [
            0.404,
            0.487,
            0.428,
            0.498
          ],
          "content": "**dict**"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.507,
            0.269,
            0.523
          ],
          "content": "• Can test if a key exists"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.522,
            0.266,
            0.537
          ],
          "content": "§ 'jrs1’ in d evals to True"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.536,
            0.272,
            0.551
          ],
          "content": "§ 'abc1' in d evals to False"
        },
        {
          "type": "text",
          "bbox": [
            0.339,
            0.516,
            0.365,
            0.53
          ],
          "content": "'jrs2'"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.551,
            0.276,
            0.568
          ],
          "content": "• But cannot slice ranges!"
        },
        {
          "type": "text",
          "bbox": [
            0.332,
            0.531,
            0.413,
            0.544
          ],
          "content": "'wmw2' 'Walker'"
        },
        {
          "type": "text",
          "bbox": [
            0.328,
            0.552,
            0.431,
            0.565
          ],
          "content": "Key-Value order in"
        },
        {
          "type": "text",
          "bbox": [
            0.322,
            0.565,
            0.439,
            0.579
          ],
          "content": "folder is not important"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.13,
            0.686,
            0.445,
            0.704
          ],
          "level": 2,
          "content": "Dictionaries: Iterable, but not Sliceable"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.716,
            0.272,
            0.733
          ],
          "content": "• Can loop over a dict"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.304,
            0.715,
            0.361,
            0.728
          ],
          "level": 2,
          "content": "for k in d:"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.734,
            0.292,
            0.75
          ],
          "content": "§ Only gives you the keys"
        },
        {
          "type": "text",
          "bbox": [
            0.316,
            0.728,
            0.419,
            0.743
          ],
          "content": "\\# Loops over **keys**"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.75,
            0.29,
            0.766
          ],
          "content": "§ Use key to access value"
        },
        {
          "type": "text",
          "bbox": [
            0.316,
            0.742,
            0.415,
            0.756
          ],
          "content": "print(k) # key"
        },
        {
          "type": "text",
          "bbox": [
            0.316,
            0.756,
            0.423,
            0.77
          ],
          "content": "print(d[k]) # value"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.785,
            0.289,
            0.801
          ],
          "content": "• Can iterate over values"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.802,
            0.267,
            0.818
          ],
          "content": "§ **Method:** d.values()"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.786,
            0.445,
            0.8
          ],
          "content": "\\# To loop over values only"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.8,
            0.407,
            0.813
          ],
          "content": "for v in d.values():"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.82,
            0.281,
            0.836
          ],
          "content": "§ But no way to get key"
        },
        {
          "type": "text",
          "bbox": [
            0.309,
            0.813,
            0.424,
            0.828
          ],
          "content": "print(v) # value"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.836,
            0.281,
            0.852
          ],
          "content": "§ Values are not unique"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.331,
            0.539,
            0.346
          ],
          "content": "2"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.658,
            0.124,
            0.765,
            0.143
          ],
          "level": 2,
          "content": "Basic Syntax"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.154,
            0.805,
            0.171
          ],
          "content": "• Create with format: {k1:v1, k2:v2, …}"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.172,
            0.764,
            0.187
          ],
          "content": "§ Both keys and values must exist"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.187,
            0.849,
            0.204
          ],
          "content": "§ **Ex:** d={‘jrs1':'John',’jrs2':'John','wmw2':'Walker'}"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.205,
            0.746,
            0.222
          ],
          "content": "• **Keys** must be **non-mutable**"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.223,
            0.764,
            0.24
          ],
          "content": "§ ints, floats, bools, strings, tuples"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.239,
            0.734,
            0.255
          ],
          "content": "§ **Not** lists or custom objects"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.255,
            0.806,
            0.271
          ],
          "content": "§ Changing a key’s contents hurts lookup"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.271,
            0.723,
            0.29
          ],
          "content": "• **Values** can be **anything**"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.592,
            0.405,
            0.829,
            0.423
          ],
          "level": 2,
          "content": "Dictionaries Can be Modified"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.435,
            0.684,
            0.45
          ],
          "content": "• Can reassign values"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.452,
            0.66,
            0.466
          ],
          "content": "§ d['jrs1'] = 'Jane’"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.466,
            0.683,
            0.482
          ],
          "content": "§ Very similar to lists"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.444,
            0.881,
            0.474
          ],
          "continues_prev": true,
          "content": "d = {'jrs1':'John','jrs2':'John', 'wmw2':'Walker'}"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.484,
            0.676,
            0.499
          ],
          "content": "• Can add new keys"
        },
        {
          "type": "text",
          "bbox": [
            0.766,
            0.484,
            0.788,
            0.496
          ],
          "content": "**id8**"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.499,
            0.668,
            0.514
          ],
          "content": "§ d[‘aaa1'] = 'Allen’"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.514,
            0.692,
            0.53
          ],
          "content": "§ Do not think of order"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.531,
            0.661,
            0.548
          ],
          "content": "• Can delete keys"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.547,
            0.649,
            0.563
          ],
          "content": "§ del d['wmw2’]"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.562,
            0.702,
            0.578
          ],
          "content": "§ Deletes both key, value"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.57,
            0.686,
            0.853,
            0.704
          ],
          "level": 2,
          "content": "Dictionary Loop with Accumulator"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.54,
            0.715,
            0.659,
            0.729
          ],
          "level": 2,
          "content": "def max\\_grade(grades):"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.728,
            0.772,
            0.743
          ],
          "content": "\"\"\"Returns max grade in the grade dictionary"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.747,
            0.829,
            0.762
          ],
          "content": "Precondition: grades has netids as keys, ints as values\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.763,
            0.627,
            0.776
          ],
          "content": "maximum = 0"
        },
        {
          "type": "text",
          "bbox": [
            0.678,
            0.763,
            0.757,
            0.776
          ],
          "content": "\\# Accumulator"
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.777,
            0.642,
            0.79
          ],
          "content": "\\# Loop over keys"
        },
        {
          "type": "text",
          "bbox": [
            0.553,
            0.79,
            0.632,
            0.804
          ],
          "content": "for k in grades:"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.804,
            0.687,
            0.819
          ],
          "content": "if grades[k] > maximum:"
        },
        {
          "type": "text",
          "bbox": [
            0.574,
            0.819,
            0.687,
            0.833
          ],
          "content": "maximum = grades[k]"
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.845,
            0.641,
            0.86
          ],
          "content": "return maximum"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.538,
            0.627
          ],
          "content": "4"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.894,
            0.116,
            0.907
          ],
          "content": "5"
        },
        {
          "type": "page_number",
          "bbox": [
            0.945,
            0.963,
            0.958,
            0.977
          ],
          "content": "1"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.894,
            0.539,
            0.907
          ],
          "content": "6"
        }
      ]
    },
    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.875,
            0.021,
            0.96,
            0.039
          ],
          "content": "10/21/26"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.142,
            0.123,
            0.434,
            0.143
          ],
          "level": 2,
          "content": "Dictionaries and Mutable Functions"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.153,
            0.388,
            0.173
          ],
          "content": "• Restrictions are different than list"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.176,
            0.412,
            0.195
          ],
          "content": "§ Okay to loop over dictionary to change"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.197,
            0.404,
            0.215
          ],
          "content": "§ You are looping over keys, not values"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.217,
            0.338,
            0.235
          ],
          "content": "§ Like looping over positions"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.237,
            0.429,
            0.257
          ],
          "content": "• But you **may not add or remove** keys!"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.26,
            0.359,
            0.278
          ],
          "content": "§ Any attempt to do this will fail"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.279,
            0.419,
            0.297
          ],
          "content": "§ Have to create a key list if you want this"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.205,
            0.405,
            0.371,
            0.424
          ],
          "level": 2,
          "content": "Nesting Dictionaries"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.435,
            0.397,
            0.473
          ],
          "content": "• Remember, values can be anything § Only restrictions are on the keys"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.474,
            0.374,
            0.513
          ],
          "content": "• Values can be lists (**Visualizer**) § d = {'a':[1,2], 'b':[3,4]}"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.515,
            0.421,
            0.553
          ],
          "content": "• Values can be other dicts (**Visualizer**) § d = {'a':{'c':1,'d':2}, 'b':{'e':3,'f':4}}"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.554,
            0.392,
            0.573
          ],
          "content": "• Access rules similar to nested lists"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.574,
            0.313,
            0.593
          ],
          "content": "§ **Example:** d['a']['d'] = 10"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.77,
            0.415,
            0.786
          ],
          "content": "§ Often the answer to a recursion, not the input"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.789,
            0.358,
            0.806
          ],
          "content": "• However, the **key list** is sliceable"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.843,
            0.393,
            0.86
          ],
          "content": "§ Helper is recursive, not the main function"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.825,
            0.332,
            0.842
          ],
          "content": "§ This requires a helper function"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.808,
            0.359,
            0.824
          ],
          "content": "§ Can recurse on key list, not the dict"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.642,
            0.124,
            0.781,
            0.142
          ],
          "level": 2,
          "content": "But This is Okay"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.331,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.548,
            0.627
          ],
          "content": "10"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.152,
            0.689,
            0.167
          ],
          "content": "def add\\_bonus(grades,bonus):"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.752,
            0.383,
            0.769
          ],
          "content": "§ So rare to be used in recursion by itself"
        },
        {
          "type": "text",
          "bbox": [
            0.55,
            0.166,
            0.767,
            0.182
          ],
          "content": "\"\"\"Gives bonus points to everyone in grades"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.185,
            0.819,
            0.201
          ],
          "content": "Precondition: grades has netids as keys, ints as values."
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.2,
            0.648,
            0.215
          ],
          "content": "bonus is an int.\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.215,
            0.744,
            0.23
          ],
          "content": "\\# No accumulator. This is a procedure"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.552,
            0.242,
            0.662,
            0.256
          ],
          "level": 2,
          "content": "for student in grades:"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.178,
            0.686,
            0.398,
            0.704
          ],
          "level": 2,
          "content": "Dictionaries and Recursion"
        },
        {
          "type": "text",
          "bbox": [
            0.561,
            0.256,
            0.817,
            0.271
          ],
          "content": "\\# Modifies the dictionary, but does not change keys"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.734,
            0.4,
            0.751
          ],
          "content": "§ Makes it difficult to do divide and conquer"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.628,
            0.405,
            0.795,
            0.424
          ],
          "level": 2,
          "content": "Example: JSON File"
        },
        {
          "type": "text",
          "bbox": [
            0.648,
            0.438,
            0.698,
            0.46
          ],
          "content": "Nested Dictionary"
        },
        {
          "type": "text",
          "bbox": [
            0.562,
            0.27,
            0.768,
            0.285
          ],
          "content": "grades[student] = grades[student]+bonus"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.44,
            0.632,
            0.47
          ],
          "content": "\"wind\" : {\"speed\" : 13.0, \"crosswind\" : 5.0"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.435,
            0.879,
            0.45
          ],
          "continues_prev": true,
          "content": "• **JSON:** File w/ Python dict"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.449,
            0.877,
            0.462
          ],
          "content": "§ Actually, minor differences"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.715,
            0.333,
            0.733
          ],
          "content": "• Dictionaries are **not sliceable**"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.463,
            0.805,
            0.477
          ],
          "content": "• weather.json:"
        },
        {
          "type": "text",
          "bbox": [
            0.55,
            0.47,
            0.663,
            0.494
          ],
          "content": "}, Nested \"sky\" : List"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.478,
            0.861,
            0.501
          ],
          "continues_prev": true,
          "content": "§ Weather measurements at Ithaca Airport (2017)"
        },
        {
          "type": "text",
          "bbox": [
            0.566,
            0.493,
            0.644,
            0.522
          ],
          "content": "\"cover\" : \"clouds\", \"type\" : \"broken\", \"height\" : 1200.0"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.5,
            0.867,
            0.514
          ],
          "continues_prev": true,
          "content": "§ **Keys**: Times (Each hour)"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.513,
            0.871,
            0.527
          ],
          "content": "§ **Values**: Weather readings"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.527,
            0.856,
            0.541
          ],
          "content": "• This is a nested JSON"
        },
        {
          "type": "text",
          "bbox": [
            0.566,
            0.537,
            0.644,
            0.558
          ],
          "continues_prev": true,
          "content": "\"type\" : \"overcast\", \"height\" : 1800.0"
        },
        {
          "type": "text",
          "bbox": [
            0.652,
            0.554,
            0.702,
            0.577
          ],
          "content": "Nested Dictionary"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.54,
            0.878,
            0.554
          ],
          "content": "§ Values are also dictionaries"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.553,
            0.883,
            0.568
          ],
          "content": "§ Containing more dictionaries"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.567,
            0.865,
            0.582
          ],
          "content": "§ And also containing lists"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.619,
            0.686,
            0.804,
            0.704
          ],
          "level": 2,
          "content": "The Recursive Version"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.715,
            0.711,
            0.728
          ],
          "content": "def max\\_grade\\_helper(netids,grades):"
        },
        {
          "type": "text",
          "bbox": [
            0.55,
            0.728,
            0.738,
            0.741
          ],
          "content": "\"\"\"Returns max grade among given netids"
        },
        {
          "type": "text",
          "bbox": [
            0.55,
            0.745,
            0.857,
            0.759
          ],
          "content": "Precond: netids a list of keys in grades, grades a dict w/ int values\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.757,
            0.65,
            0.77
          ],
          "content": "\\# Process small data"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.77,
            0.641,
            0.782
          ],
          "content": "if len(netids) <= 1:"
        },
        {
          "type": "text",
          "bbox": [
            0.559,
            0.782,
            0.784,
            0.796
          ],
          "content": "return grades[netids[0]] if len(netids) == 1 else 0"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.8,
            0.697,
            0.814
          ],
          "content": "\\# Break it up into left and right"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.814,
            0.664,
            0.827
          ],
          "content": "left = grades[netids[0]]"
        },
        {
          "type": "text",
          "bbox": [
            0.55,
            0.826,
            0.751,
            0.84
          ],
          "content": "right = max\\_grade\\_helper(netids[1:],grades)"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.845,
            0.662,
            0.858
          ],
          "content": "\\# Combine the answers"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.858,
            0.655,
            0.872
          ],
          "content": "return max(left,right)"
        },
        {
          "type": "page_number",
