        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.195,
            0.686,
            0.38,
            0.705
          ],
          "level": 2,
          "content": "Error Types in Python"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.71,
            0.406,
            0.727
          ],
          "content": "• All errors are instances of class BaseException"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.728,
            0.404,
            0.744
          ],
          "content": "• This allows us to organize them in a hierarchy"
        },
        {
          "type": "image",
          "bbox": [
            0.118,
            0.744,
            0.461,
            0.852
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_0_image_44.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.358,
            0.795,
            0.407,
            0.808
          ],
          "content": "'My error'"
        },
        {
          "type": "text",
          "bbox": [
            0.347,
            0.822,
            0.448,
            0.845
          ],
          "content": "→ means “extends” <u>or “is an instance of”</u>"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.538,
            0.627
          ],
          "content": "4"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.619,
            0.405,
            0.804,
            0.424
          ],
          "level": 2,
          "content": "Error Types in Python"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.435,
            0.597,
            0.45
          ],
          "content": "def foo():"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.5,
            0.599,
            0.515
          ],
          "content": "<u>>>> foo()</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.5,
            0.774,
            0.515
          ],
          "content": ">>> foo()"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.516,
            0.688,
            0.532
          ],
          "content": "<u>AssertionError</u>: My error"
        },
        {
          "type": "text",
          "bbox": [
            0.712,
            0.515,
            0.869,
            0.531
          ],
          "content": "<u>ZeroDivisionError:</u> integer"
        },
        {
          "type": "text",
          "bbox": [
            0.619,
            0.543,
            0.694,
            0.558
          ],
          "content": "**Class Names**"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.53,
            0.869,
            0.545
          ],
          "content": "division or modulo by zero"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.589,
            0.685,
            0.834,
            0.705
          ],
          "level": 2,
          "content": "Python Error Type Hierarchy"
        },
        {
          "type": "text",
          "bbox": [
            0.529,
            0.708,
            0.891,
            0.81
          ],
          "content": "<u>BaseException</u> Argument has Argument has wrong type wrong value <u>SystemExit Exception</u> (e.g. float([1])) (e.g. float('a')) <u>AssertionError AttributeError ArithmeticError IOError TypeError ValueError ZeroDivisionError OverflowError</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.545,
            0.822,
            0.687,
            0.855
          ],
          "content": "http://docs.python.org/<u>library/exceptions.html</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.83,
            0.875,
            0.846
          ],
          "content": "Why so many error types?"
        },
        {
          "type": "page_number",
          "bbox": [
            0.945,
