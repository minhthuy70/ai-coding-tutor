    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "header",
          "bbox": [
            0.875,
            0.021,
            0.961,
            0.039
          ],
          "content": "11/18/26"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.185,
            0.124,
            0.392,
            0.144
          ],
          "level": 2,
          "content": "Handling Errors by Type"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.154,
            0.436,
            0.17
          ],
          "content": "• try-except blocks can be restricted to **specific** errors"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.169,
            0.382,
            0.184
          ],
          "content": "§ Doe except if error is **an instance** of that type"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.183,
            0.345,
            0.197
          ],
          "content": "§ If error not an instance, do not recover"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.199,
            0.197,
            0.214
          ],
          "content": "• **Example**:"
        },
        {
          "type": "text",
          "bbox": [
            0.381,
            0.211,
            0.459,
            0.223
          ],
          "content": "May have IOError"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.215,
            0.161,
            0.228
          ],
          "content": "try:"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.227,
            0.221,
            0.242
          ],
          "content": "val = input()"
        },
        {
          "type": "text",
          "bbox": [
            0.239,
            0.227,
            0.361,
            0.241
          ],
          "content": "\\# get number from user"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.241,
            0.361,
            0.255
          ],
          "content": "x = float(val) # convert string to float"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.255,
            0.339,
            0.269
          ],
          "content": "print('The next number is '+str(x+1))"
        },
        {
          "type": "text",
          "bbox": [
            0.376,
            0.254,
            0.463,
            0.267
          ],
          "content": "May have ValueError"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.269,
            0.231,
            0.283
          ],
          "content": "except ValueError:"
        },
        {
          "type": "text",
          "bbox": [
            0.355,
            0.27,
            0.458,
            0.29
          ],
          "content": "Only recovers ValueError. Other errors ignored."
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.283,
            0.324,
            0.298
          ],
          "content": "print('Hey! That is not a number!')"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.604,
            0.124,
            0.819,
            0.143
          ],
          "level": 2,
          "content": "Creating Errors in Python"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.152,
            0.696,
            0.168
          ],
          "content": "• Create errors with raise"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.332,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.153,
            0.778,
            0.168
          ],
          "content": "def foo(x):"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.169,
            0.672,
            0.184
          ],
          "content": "§ **Usage**: raise &lt;exp&gt;"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.183,
            0.702,
            0.197
          ],
          "content": "§ exp evaluates to an object"
        },
        {
          "type": "text",
          "bbox": [
            0.724,
            0.169,
            0.861,
            0.185
          ],
          "content": "assert x < 2, 'My error'"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.197,
            0.702,
            0.211
          ],
          "content": "§ An instance of Exception"
        },
        {
          "type": "text",
          "bbox": [
            0.725,
            0.19,
            0.743,
            0.202
          ],
          "content": "…"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.212,
            0.694,
            0.228
          ],
          "content": "• Tailor your error types"
        },
        {
          "type": "text",
          "bbox": [
            0.782,
            0.199,
            0.835,
            0.213
          ],
          "content": "Identical"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.227,
            0.696,
            0.242
          ],
          "content": "§ **ValueError**: Bad value"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.218,
            0.779,
            0.234
          ],
          "content": "def foo(x):"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.241,
            0.688,
            0.256
          ],
          "content": "§ **TypeError**: Bad type"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.256,
            0.698,
            0.285
          ],
          "content": "• Still prefer **asserts** for preconditions, however"
        },
        {
          "type": "text",
          "bbox": [
            0.725,
            0.234,
            0.782,
            0.248
          ],
          "content": "if x >= 2:"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.285,
            0.705,
            0.3
          ],
          "content": "§ Compact and easy to read"
        },
        {
          "type": "text",
          "bbox": [
            0.739,
            0.25,
            0.826,
            0.265
          ],
          "content": "m = 'My error'"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.266,
            0.882,
            0.282
          ],
          "content": "err = AssertionError(m)"
        },
        {
          "type": "text",
          "bbox": [
            0.739,
            0.283,
            0.797,
            0.298
          ],
          "content": "raise err"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.185,
            0.406,
            0.392,
            0.425
          ],
          "level": 2,
          "content": "Handling Errors by Type"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.435,
            0.368,
            0.451
          ],
          "content": "• try-except can put the error in a variable"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.452,
            0.196,
            0.467
          ],
          "content": "• **Example**:"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.468,
            0.16,
            0.481
          ],
          "content": "try:"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.481,
            0.362,
            0.495
          ],
          "content": "val = input() # get number from user"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.495,
            0.362,
            0.509
          ],
          "content": "x = float(val) # convert string to float"
        },
        {
          "type": "text",
          "bbox": [
            0.152,
            0.509,
            0.338,
            0.523
          ],
          "content": "print('The next number is '+str(x+1))"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.523,
            0.253,
            0.536
          ],
          "content": "except ValueError as e:"
        },
        {
          "type": "text",
          "bbox": [
            0.335,
            0.523,
            0.453,
            0.537
          ],
          "content": "Some Error subclasses"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.537,
            0.235,
            0.551
          ],
          "content": "print(e.args[0])"
        },
        {
          "type": "text",
          "bbox": [
            0.34,
            0.537,
            0.449,
            0.55
          ],
          "content": "have more attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.151,
            0.55,
            0.323,
            0.565
          ],
          "content": "print('Hey! That is not a number!')"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.584,
            0.405,
            0.839,
            0.424
          ],
          "level": 2,
          "content": "Creating Your Own Exceptions"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.434,
            0.669,
            0.447
          ],
          "content": "class CustomError(Exception):"
        },
        {
          "type": "text",
          "bbox": [
            0.548,
            0.446,
            0.702,
            0.47
          ],
          "content": "\"\"\"An instance is a custom exception\"\"\" pass"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.483,
            0.685,
            0.498
          ],
          "content": "This is all you need"
        },
        {
          "type": "text",
          "bbox": [
            0.569,
            0.498,
            0.665,
            0.512
          ],
          "content": "§ No extra fields"
        },
        {
          "type": "text",
          "bbox": [
            0.745,
            0.457,
            0.856,
            0.508
          ],
          "content": "Only issues is choice of parent error class. Use Exception if you are unsure what."
        },
        {
          "type": "text",
          "bbox": [
            0.57,
            0.512,
            0.679,
            0.526
          ],
          "content": "§ No extra methods"
        },
        {
          "type": "text",
          "bbox": [
            0.569,
            0.525,
            0.67,
            0.54
          ],
          "content": "§ No constructors"
        },
        {
          "type": "text",
          "bbox": [
            0.568,
            0.541,
            0.681,
            0.558
          ],
          "content": "Inherit everything"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.216,
            0.686,
            0.359,
            0.704
          ],
          "level": 2,
          "content": "Case Study: Files"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.716,
            0.428,
            0.733
          ],
          "content": "• Can read the contents of any file with open()"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.735,
            0.385,
            0.751
          ],
          "content": "§ Returns a file object with method read()"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.753,
            0.394,
            0.769
          ],
          "content": "§ Method read() returns contents as a string"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.77,
            0.363,
            0.786
          ],
          "content": "§ Remember to close() file when done"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.789,
            0.417,
            0.807
          ],
          "content": "• There are **SO** many errors that can happen"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.808,
            0.367,
            0.824
          ],
          "content": "§ FileNotFoundError: File does not exit"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.825,
            0.425,
            0.842
          ],
          "content": "§ PermissionError: You are not allowed to read it"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.843,
            0.404,
            0.86
          ],
          "content": "§ Other errors possible when processing data"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.625,
            0.686,
            0.798,
            0.704
          ],
          "level": 2,
          "content": "Reading a JSON File"
        },
        {
          "type": "text",
          "bbox": [
            0.659,
            0.715,
            0.716,
            0.74
          ],
          "content": "Open file <u>with name</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.658,
            0.751,
            0.717,
            0.777
          ],
          "content": "Close file <u>when done</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.746,
            0.727,
            0.858,
            0.773
          ],
          "content": "Note that we can chain excepts like an if-elif statement"
        },
        {
          "type": "text",
          "bbox": [
            0.564,
            0.778,
            0.688,
            0.791
          ],
          "content": "result = json.loads(data)"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.79,
            0.635,
            0.804
          ],
          "content": "return result"
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.803,
            0.686,
            0.817
          ],
          "content": "except FileNotFoundError:"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.79,
            0.79,
            0.815
          ],
          "content": "Could not find file"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.816,
            0.694,
            0.83
          ],
          "content": "print(fname +' not found')"
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.829,
            0.681,
            0.842
          ],
          "content": "except JsonDecodeError:"
        },
        {
          "type": "text",
          "bbox": [
            0.721,
            0.817,
            0.801,
            0.843
          ],
          "content": "JSON contents are not valid"
        },
        {
          "type": "text",
          "bbox": [
            0.563,
            0.842,
            0.694,
            0.855
          ],
          "continues_prev": true,
          "content": "print(fname +' i<u>s invalid')</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.552,
            0.854,
            0.699,
            0.87
          ],
          "content": "return None If failed"
        },
        {
