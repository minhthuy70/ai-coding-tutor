        {
          "type": "text",
          "bbox": [
            0.597,
            0.259,
            0.702,
            0.275
          ],
          "content": "Similar to if-else"
        },
        {
          "type": "text",
          "bbox": [
            0.599,
            0.275,
            0.768,
            0.29
          ],
          "content": "§ But always does the try block"
        },
        {
          "type": "text",
          "bbox": [
            0.598,
            0.29,
            0.779,
            0.305
          ],
          "content": "§ Might not do **all** of the try block"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.165,
            0.406,
            0.411,
            0.424
          ],
          "level": 2,
          "content": "Try-Except and the Call Stack"
        },
        {
          "type": "text",
          "bbox": [
            0.261,
            0.435,
            0.452,
            0.451
          ],
          "content": "• Error “pops” frames off stack"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.457,
            0.203,
            0.47
          ],
          "content": "def function\\_1(x,y):"
        },
        {
          "type": "text",
          "bbox": [
            0.278,
            0.451,
            0.439,
            0.465
          ],
          "content": "§ Starts from the stack bottom"
        },
        {
          "type": "text",
          "bbox": [
            0.279,
            0.465,
            0.437,
            0.49
          ],
          "content": "§ Continues until it sees that current line is in a try-block"
        },
        {
          "type": "text",
          "bbox": [
            0.278,
            0.49,
            0.426,
            0.515
          ],
          "content": "§ Jumps to except, and then proceeds as if no error"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.527,
            0.203,
            0.54
          ],
          "content": "def function\\_2(x,y):"
        },
        {
          "type": "text",
          "bbox": [
            0.127,
            0.54,
            0.231,
            0.553
          ],
          "content": "return function\\_3(x,y)"
        },
        {
          "type": "text",
          "bbox": [
            0.267,
            0.52,
            0.329,
            0.535
          ],
          "content": "line in a try"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.562,
            0.205,
            0.575
          ],
          "content": "def function\\_3(x,y):"
        },
        {
          "type": "text",
          "bbox": [
            0.342,
            0.521,
            0.402,
            0.535
          ],
          "content": "function\\_1"
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.574,
            0.237,
            0.586
          ],
          "content": "return x/y # crash here"
        },
        {
          "type": "text",
          "bbox": [
            0.342,
            0.542,
            0.403,
            0.556
          ],
          "content": "function\\_2"
        },
