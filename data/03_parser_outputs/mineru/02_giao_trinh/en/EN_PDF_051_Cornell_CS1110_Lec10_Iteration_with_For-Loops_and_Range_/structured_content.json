            0.535,
            0.418,
            0.547
          ],
          "content": "'Walker White'"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.56,
            0.233,
            0.575
          ],
          "content": "10. end = s.find(' ')"
        },
        {
          "type": "text",
          "bbox": [
            0.118,
            0.575,
            0.232,
            0.589
          ],
          "content": "11. return s[0:end]"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.227,
            0.686,
            0.349,
            0.704
          ],
          "level": 2,
          "content": "The Call Stack"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.716,
            0.265,
            0.731
          ],
          "content": "• Functions are **stacked**"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.732,
            0.282,
            0.759
          ],
          "content": "§ Cannot remove one above w/o removing one below"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.76,
            0.289,
            0.787
          ],
          "content": "§ Sometimes draw bottom up (better fits the metaphor)"
        },
        {
          "type": "text",
          "bbox": [
            0.358,
            0.733,
            0.404,
            0.745
          ],
          "content": "Frame 1"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.79,
            0.284,
            0.804
          ],
          "content": "• Stack represents memory"
        },
        {
          "type": "text",
          "bbox": [
            0.359,
            0.755,
            0.405,
            0.766
          ],
          "content": "Frame 2"
        },
        {
          "type": "text",
          "bbox": [
            0.13,
            0.805,
            0.263,
            0.82
          ],
          "content": "as a **high water mark**"
        },
        {
          "type": "text",
          "bbox": [
            0.359,
            0.775,
            0.404,
            0.788
          ],
          "content": "Frame 3"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.82,
            0.301,
            0.847
          ],
          "content": "§ Must have enough to keep the **entire stack in memory**"
        },
        {
          "type": "text",
          "bbox": [
            0.359,
            0.797,
            0.405,
            0.81
          ],
          "content": "Frame 4"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.848,
            0.281,
            0.863
          ],
          "content": "§ Error if cannot hold stack"
        },
        {
          "type": "image",
          "bbox": [
            0.424,
            0.731,
            0.461,
            0.831
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_1_image_50.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.359,
            0.818,
            0.405,
            0.83
          ],
          "content": "Frame 6  5"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.58,
            0.124,
            0.842,
            0.142
          ],
          "level": 2,
          "content": "Function Access to Global Space"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.152,
            0.696,
            0.184
          ],
          "content": "• All function definitions are in some module"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.185,
            0.692,
            0.214
          ],
          "content": "• Call can access global space for **that module**"
        },
        {
          "type": "text",
          "bbox": [
            0.761,
            0.154,
            0.871,
            0.179
          ],
          "content": "**Global Space** (for globals.py) a 4"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.215,
            0.702,
            0.229
          ],
          "content": "§ math.cos: global for math"
        },
        {
          "type": "text",
          "bbox": [
            0.761,
            0.188,
            0.802,
            0.2
          ],
          "content": "**change\\_a**"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.332,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.23,
            0.711,
            0.256
          ],
          "content": "§ temperature.to\\_centigrade uses global for temperature"
        },
        {
          "type": "text",
          "bbox": [
            0.744,
            0.234,
            0.795,
            0.245
          ],
          "content": "\\# globals.py"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.256,
            0.712,
            0.272
          ],
          "content": "• But **cannot** change values"
        },
        {
          "type": "text",
          "bbox": [
            0.745,
            0.246,
            0.858,
            0.257
          ],
          "content": "\"\"\"Show how globals work\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.273,
            0.717,
            0.287
          ],
          "content": "§ Makes a new local variable!"
        },
        {
          "type": "text",
          "bbox": [
            0.743,
            0.257,
            0.826,
            0.269
          ],
          "content": "a = 4 # global space"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.288,
            0.708,
            0.303
          ],
          "content": "§ Why we limit to constants"
        },
        {
          "type": "text",
          "bbox": [
            0.743,
            0.276,
            0.81,
            0.288
          ],
          "content": "**def** change\\_a():"
        },
        {
          "type": "text",
          "bbox": [
            0.758,
            0.289,
            0.856,
            0.3
          ],
          "content": "a = 3.5 # local variable"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.591,
            0.406,
            0.831,
            0.423
          ],
          "level": 2,
          "content": "Frames and Helper Functions"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.434,
            0.678,
            0.448
          ],
          "content": "1. def last\\_name\\_first(s):"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.448,
            0.555,
            0.461
          ],
          "content": "2."
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.435,
            0.872,
            0.446
          ],
          "content": "**Call:** last\\_name\\_first('Walker White'):"
        },
        {
          "type": "text",
          "bbox": [
            0.574,
            0.448,
            0.698,
            0.462
          ],
          "content": "\"\"\"**Precond**: s in the form"
        },
        {
          "type": "text",
          "bbox": [
            0.84,
            0.449,
            0.855,
            0.461
          ],
          "content": "5"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.462,
            0.555,
            0.475
          ],
          "content": "3."
        },
        {
          "type": "text",
          "bbox": [
            0.749,
            0.449,
            0.818,
            0.461
          ],
          "content": "last\\_name\\_first"
        },
        {
          "type": "text",
          "bbox": [
            0.574,
            0.462,
            0.697,
            0.475
          ],
          "content": "'first-name last-name' \"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.476,
            0.555,
            0.488
          ],
          "content": "4."
        },
        {
          "type": "text",
          "bbox": [
            0.574,
            0.476,
            0.679,
            0.49
          ],
          "content": "first = first\\_name(s)"
        },
        {
          "type": "text",
          "bbox": [
            0.751,
            0.469,
            0.841,
            0.481
          ],
          "content": "s 'Walker White'"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.49,
            0.555,
            0.502
          ],
          "content": "5."
        },
        {
          "type": "text",
          "bbox": [
            0.573,
            0.49,
            0.672,
            0.503
          ],
          "content": "<u>last = last\\_name(s)</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.751,
            0.489,
            0.775,
            0.5
          ],
          "content": "first"
        },
        {
          "type": "text",
          "bbox": [
            0.797,
            0.489,
            0.833,
            0.5
          ],
          "content": "'Walker'"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.505,
            0.555,
            0.517
          ],
          "content": "6."
        },
        {
          "type": "text",
          "bbox": [
            0.574,
            0.505,
            0.684,
            0.517
          ],
          "content": "return last + ',' + first"
        },
        {
          "type": "text",
          "bbox": [
            0.749,
            0.515,
            0.795,
            0.527
          ],
          "content": "last\\_name"
        },
        {
          "type": "text",
          "bbox": [
            0.839,
            0.515,
            0.858,
            0.527
          ],
          "content": "**15**"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.532,
            0.651,
            0.545
          ],
          "content": "13. def last\\_name(s):"
        },
        {
          "type": "text",
          "bbox": [
            0.542,
            0.546,
            0.559,
            0.559
          ],
          "content": "14."
        },
        {
