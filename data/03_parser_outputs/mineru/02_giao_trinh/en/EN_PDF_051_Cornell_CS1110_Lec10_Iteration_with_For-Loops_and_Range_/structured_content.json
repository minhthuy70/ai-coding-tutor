        {
          "type": "text",
          "bbox": [
            0.576,
            0.545,
            0.698,
            0.56
          ],
          "content": "\"\"\"**Precond**: see above\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.542,
            0.561,
            0.559,
            0.574
          ],
          "content": "15."
        },
        {
          "type": "text",
          "bbox": [
            0.779,
            0.535,
            0.84,
            0.547
          ],
          "content": "'Walker White'"
        },
        {
          "type": "text",
          "bbox": [
            0.542,
            0.575,
            0.56,
            0.588
          ],
          "content": "16."
        },
        {
          "type": "text",
          "bbox": [
            0.577,
            0.561,
