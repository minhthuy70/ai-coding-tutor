          "content": "The Call Stack"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.436,
            0.351,
            0.452
          ],
          "content": "• The area **where call frames live**"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.455,
            0.39,
            0.47
          ],
          "content": "§ Call frames are created on a function call"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.472,
            0.43,
            0.488
          ],
          "content": "§ May be several frames (functions call functions)"
