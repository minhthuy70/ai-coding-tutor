        {
          "type": "text",
          "bbox": [
            0.134,
            0.49,
            0.387,
            0.505
          ],
          "content": "§ Each frame deleted as the call completes"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.51,
            0.374,
            0.525
          ],
          "content": "• Area of volatile, temporary memory"
