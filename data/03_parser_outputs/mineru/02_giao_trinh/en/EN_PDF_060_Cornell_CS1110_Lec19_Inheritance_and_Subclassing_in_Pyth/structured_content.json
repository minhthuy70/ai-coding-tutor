            0.18
          ],
          "content": "§ start with an **underscore**"
        },
        {
          "type": "text",
          "bbox": [
            0.301,
            0.163,
            0.443,
            0.176
          ],
          "content": "\"\"\"Class to represent times of day."
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.18,
            0.266,
            0.194
          ],
          "content": "§ do not show up in help()"
        },
        {
          "type": "text",
          "bbox": [
            0.301,
            0.178,
            0.42,
            0.199
          ],
          "content": "Inv: hour is an int in 0..23 Inv: min is an int in 0..59\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.194,
            0.266,
            0.216
          ],
          "content": "§ are meant to be **internal** (e.g. helper methods)"
        },
        {
          "type": "text",
          "bbox": [
            0.301,
            0.207,
            0.402,
            0.22
          ],
          "content": "def \\_is\\_minute(self,m):"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.215,
            0.273,
            0.23
          ],
          "content": "• But they are **not restricted**"
        },
        {
          "type": "text",
          "bbox": [
            0.311,
            0.219,
            0.458,
            0.231
          ],
          "content": "\"\"\"Return: True if m valid minute\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.23,
            0.271,
            0.244
          ],
          "content": "§ You can still access them"
        },
        {
          "type": "text",
          "bbox": [
            0.31,
            0.23,
            0.427,
            0.242
          ],
          "content": "return (type(m) == int and"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.243,
            0.263,
            0.256
          ],
          "content": "§ But this is bad practice!"
        },
        {
          "type": "text",
          "bbox": [
            0.34,
            0.24,
            0.429,
            0.252
          ],
          "content": "m >= 0 and m < 60)"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.255,
            0.266,
            0.269
          ],
          "content": "§ Like a precond violation"
        },
        {
          "type": "text",
          "bbox": [
            0.302,
            0.261,
            0.424,
            0.273
          ],
          "content": "def \\_\\_init\\_\\_(self, hour, min):"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.269,
            0.28,
            0.283
          ],
          "content": "• Can do same for attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.311,
            0.272,
            0.404,
            0.282
          ],
          "content": "\"\"\"The time hour:min The time hour:min."
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.283,
            0.282,
            0.297
          ],
          "content": "§ Underscore makes it hidden"
        },
        {
          "type": "text",
          "bbox": [
            0.311,
            0.278,
            0.45,
            0.29
          ],
          "content": "Pre: hour in 0..23; min in 0..59\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.296,
            0.284,
            0.31
          ],
          "content": "§ Only used inside of methods"
        },
        {
          "type": "text",
          "bbox": [
            0.311,
            0.289,
            0.423,
            0.3
          ],
          "content": "assert self.\\_is\\_minute(m)"
        },
        {
          "type": "text",
          "bbox": [
            0.384,
            0.3,
            0.421,
            0.311
          ],
          "content": "Helper"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.625,
            0.124,
            0.798,
            0.143
          ],
          "level": 2,
          "content": "Enforcing Invariants"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.152,
            0.635,
            0.166
          ],
          "content": "class Time(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.166,
            0.695,
            0.18
          ],
          "content": "\"\"\"Class to repr times of day."
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.152,
            0.87,
            0.167
          ],
          "content": "• **Idea**: Restrict direct access"
        },
        {
          "type": "text",
          "bbox": [
            0.551,
            0.182,
            0.687,
            0.208
          ],
          "content": "Inv: hour is an int in 0..23 Inv: <u>min is an int in 0..59</u> \"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.167,
            0.865,
            0.18
          ],
          "content": "§ Only access via methods"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.18,
            0.876,
            0.194
          ],
          "content": "§ Use asserts to enforce them"
        },
        {
          "type": "text",
          "bbox": [
            0.616,
            0.211,
            0.689,
            0.241
          ],
          "content": "**Invariants**: Properties that <u>are always true.</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.193,
            0.788,
            0.207
          ],
          "content": "• **Example**:"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.332,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "text",
          "bbox": [
            0.729,
            0.206,
            0.809,
            0.218
          ],
          "content": "def getHour(self):"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.242,
            0.688,
            0.282
          ],
          "content": "• These are just comments! >>> t = Time(2,30) >>> t.hour = 'Hello'"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.217,
            0.839,
            0.23
          ],
          "content": "\"\"\"Returns: the hour\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.739,
            0.23,
            0.812,
            0.241
          ],
          "content": "return self.hour"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.282,
            0.686,
            0.298
          ],
          "content": "• How do we prevent this?"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.246,
            0.834,
            0.26
          ],
          "content": "def setHour (self,value):"
        },
        {
          "type": "text",
          "bbox": [
            0.738,
            0.259,
            0.841,
            0.271
          ],
          "content": "\"\"\"Sets hour to value\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.74,
            0.27,
            0.847,
            0.282
          ],
          "content": "assert type(value) == int"
        },
        {
          "type": "text",
          "bbox": [
            0.741,
            0.282,
            0.877,
            0.294
          ],
          "content": "assert value >= 0 and value < 24"
        },
        {
          "type": "text",
          "bbox": [
            0.741,
            0.292,
            0.838,
            0.304
          ],
          "content": "self.numerator = value"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.207,
            0.405,
            0.369,
            0.424
          ],
          "level": 2,
          "content": "Data Encapsulation"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.435,
            0.407,
            0.453
          ],
          "content": "• **Idea**: Force the user to only use methods"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.454,
            0.396,
            0.471
          ],
          "content": "• Do not allow direct access of attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.146,
            0.475,
            0.255,
            0.491
          ],
          "content": "**Setter Method**"
        },
        {
          "type": "text",
          "bbox": [
            0.319,
            0.475,
            0.432,
            0.491
          ],
          "content": "**Getter Method**"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.495,
            0.272,
            0.51
          ],
          "content": "• Used to change an attribute"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.495,
            0.444,
            0.51
          ],
          "content": "• Used to access an attribute"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.51,
            0.267,
            0.536
          ],
          "content": "• Replaces all assignment statements to the attribute"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.51,
            0.438,
            0.536
          ],
          "continues_prev": true,
          "content": "• Replaces all usage of attribute in an expression"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.536,
            0.207,
            0.562
          ],
          "content": "• **Bad**: >>> t.hour = 5"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.536,
            0.339,
            0.55
          ],
          "content": "• **Bad**:"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.549,
            0.391,
            0.562
          ],
          "content": ">>> x = 3\\*t.hour"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.563,
            0.171,
            0.576
          ],
          "content": "• **Good**:"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.563,
            0.348,
            0.576
          ],
          "content": "• **Good**:"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.576,
            0.216,
            0.59
          ],
          "content": ">>> f.setHour(5)"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.576,
            0.412,
            0.59
          ],
          "content": ">>> x = 3\\*t.getHour()"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.631,
            0.406,
            0.792,
            0.424
          ],
          "level": 2,
          "content": "Data Encapsulation"
        },
        {
          "type": "text",
          "bbox": [
            0.579,
            0.435,
            0.668,
            0.447
          ],
          "content": "class Time(object):"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.614,
            0.548,
            0.627
          ],
          "content": "10"
        },
        {
          "type": "text",
          "bbox": [
            0.588,
            0.445,
            0.736,
            0.459
          ],
          "content": "\"\"\"Class to repr times of day. \"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.748,
            0.434,
            0.857,
            0.448
          ],
          "content": "**NO ATTRIBUTES**"
        },
        {
          "type": "text",
          "bbox": [
            0.747,
            0.45,
            0.858,
            0.464
          ],
          "content": "in class specification"
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.472,
            0.588,
            0.486
          ],
          "content": "**Getter**"
        },
        {
          "type": "text",
          "bbox": [
            0.592,
            0.475,
            0.678,
            0.488
          ],
          "content": "def getHour (self):"
        },
        {
          "type": "text",
          "bbox": [
            0.597,
            0.485,
            0.731,
            0.51
          ],
          "content": "\"\"\"Returns: hour attribute\"\"\" return self.\\_hour"
        },
        {
          "type": "text",
          "bbox": [
            0.743,
            0.479,
            0.863,
            0.494
          ],
          "content": "**Method specifications**"
        },
        {
          "type": "text",
          "bbox": [
            0.547,
            0.51,
            0.586,
            0.524
          ],
          "content": "**Setter**"
        },
        {
          "type": "text",
          "bbox": [
            0.745,
            0.495,
            0.861,
            0.509
          ],
          "content": "describe the attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.591,
            0.517,
            0.686,
            0.53
          ],
          "content": "def setHour(self, h):"
        },
        {
          "type": "text",
          "bbox": [
            0.601,
            0.529,
            0.685,
            0.54
          ],
          "content": "\"\"\" Sets hour to h"
        },
        {
          "type": "text",
          "bbox": [
            0.601,
            0.539,
            0.721,
            0.552
          ],
          "content": "Pre: h is an int in 0..23\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.743,
            0.526,
            0.864,
            0.54
          ],
          "content": "**Setter precondition** is"
        },
        {
          "type": "text",
          "bbox": [
            0.601,
            0.551,
            0.701,
            0.562
          ],
          "content": "assert type(h) == int"
        },
        {
          "type": "text",
          "bbox": [
            0.601,
            0.561,
            0.718,
            0.573
          ],
          "content": "assert 0 <= h and h < 24"
        },
        {
          "type": "text",
          "bbox": [
            0.743,
            0.54,
            0.861,
            0.554
          ],
          "content": "same as the **invariant**"
        },
        {
          "type": "text",
          "bbox": [
            0.601,
            0.572,
            0.672,
            0.585
          ],
          "content": "self.\\_hour = d"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.154,
            0.686,
            0.421,
            0.705
          ],
          "level": 2,
          "content": "Encapsulation and Specifications"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.116,
            0.716,
            0.241,
            0.732
          ],
          "level": 2,
          "content": "class Time(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.731,
            0.374,
            0.749
          ],
          "content": "\"\"\"Class to represent times of day. \"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.379,
            0.729,
            0.452,
            0.755
          ],
          "content": "No attributes <u>in class spec</u>"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.759,
            0.286,
            0.775
          ],
          "content": "\\### Hidden attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.346,
            0.768,
            0.438,
            0.781
          ],
          "content": "These comments"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.775,
            0.321,
            0.791
          ],
          "content": "\\# Att \\_hour: hour of the day"
        },
        {
          "type": "text",
          "bbox": [
            0.345,
            0.781,
            0.444,
            0.794
          ],
          "content": "make it part of the"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.791,
            0.331,
            0.806
          ],
          "content": "\\# Inv: \\_hour is an int in 0..23"
        },
        {
          "type": "text",
          "bbox": [
            0.346,
            0.794,
            0.431,
            0.805
          ],
          "content": "**class invariant**"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.807,
            0.335,
            0.822
          ],
          "content": "\\# Att \\_min: minute of the hour"
        },
        {
          "type": "text",
          "bbox": [
            0.346,
            0.804,
            0.443,
            0.818
          ],
          "content": "but not part of the"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.822,
            0.324,
            0.838
          ],
          "content": "\\# Inv: \\_min is an int in 0..59"
        },
        {
          "type": "text",
          "bbox": [
            0.346,
            0.818,
            0.443,
            0.831
          ],
          "content": "(public) **interface**"
        },
        {
          "type": "text",
          "bbox": [
            0.177,
            0.844,
            0.274,
            0.856
          ],
          "content": "These comments"
        },
        {
          "type": "text",
          "bbox": [
            0.176,
            0.855,
            0.274,
            0.869
          ],
          "content": "<u>do not go in help()</u>"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.572,
            0.685,
            0.85,
            0.705
          ],
          "level": 2,
          "content": "Mutable vs. Immutable Attributes"
        },
        {
          "type": "text",
          "bbox": [
            0.594,
            0.719,
            0.655,
            0.735
          ],
          "content": "**Mutable**"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.744,
            0.69,
            0.759
          ],
          "content": "• Can change value directly"
        },
        {
          "type": "text",
          "bbox": [
            0.76,
            0.719,
            0.838,
            0.735
          ],
          "content": "**Immutable**"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.76,
            0.675,
            0.774
          ],
          "content": "§ If class invariant met"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.744,
            0.871,
            0.759
          ],
          "content": "• Can’t change value directly"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.775,
            0.678,
            0.789
          ],
          "content": "§ **Example:** turtle.color"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.76,
            0.882,
            0.774
          ],
          "content": "§ May change “behind scenes”"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.791,
            0.698,
            0.805
          ],
          "content": "• Has both getters and setters"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.775,
            0.835,
            0.79
          ],
          "content": "§ **Example:** turtle.x"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.791,
            0.822,
            0.805
          ],
          "content": "• Has only a getter"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.806,
            0.703,
            0.821
          ],
          "content": "§ Setters allow you to change"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.821,
            0.707,
            0.835
          ],
          "content": "§ Enforce invariants w/ asserts"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.806,
            0.875,
            0.82
          ],
          "content": "§ No setter means no change"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.821,
            0.878,
            0.835
          ],
          "content": "§ Getter allows limited access"
        },
        {
          "type": "text",
          "bbox": [
            0.592,
            0.844,
            0.836,
            0.861
          ],
          "content": "May ask you to differentiate on the exam"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.894,
            0.124,
            0.907
          ],
          "content": "11"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.894,
            0.548,
            0.907
          ],
          "content": "12"
        },
        {
          "type": "page_number",
          "bbox": [
            0.945,
            0.963,
            0.959,
            0.977
          ],
          "content": "2"
        }
      ]
    }
  ],
