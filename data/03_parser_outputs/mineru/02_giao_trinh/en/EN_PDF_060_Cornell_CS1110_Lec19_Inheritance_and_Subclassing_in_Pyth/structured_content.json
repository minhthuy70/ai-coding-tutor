          ],
          "content": "10/25/26"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.156,
            0.124,
            0.419,
            0.142
          ],
          "level": 2,
          "content": "What Does str() Do On Objects?"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.152,
            0.276,
            0.195
          ],
          "content": "• Does **NOT** display contents >>> p = Point3(1,2,3) >>> str(p)"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.153,
            0.378,
            0.165
          ],
          "content": "class Point3(object):"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.165,
            0.44,
            0.177
          ],
          "content": "\"\"\"Class for points in 3d space\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.194,
            0.291,
            0.208
          ],
          "content": "'&lt;Point3 object at 0x1007a90&gt;'"
        },
        {
          "type": "text",
          "bbox": [
            0.304,
            0.188,
            0.381,
            0.2
          ],
          "content": "def \\_\\_str\\_\\_(self):"
        },
        {
          "type": "text",
          "bbox": [
            0.312,
            0.2,
            0.457,
            0.212
          ],
          "content": "\"\"\"Returns: string with contents\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.209,
            0.272,
            0.223
          ],
          "content": "• Must add a special method"
        },
        {
          "type": "text",
          "bbox": [
            0.312,
            0.212,
            0.426,
            0.224
          ],
          "content": "return '('+str(self.x) + ',' +"
        },
        {
          "type": "text",
          "bbox": [
            0.136,
            0.223,
            0.231,
            0.236
          ],
          "content": "§ \\_\\_str\\_\\_ for str()"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.223,
            0.425,
            0.235
          ],
          "content": "str(self.y) + ',' +"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.236,
            0.242,
            0.249
          ],
          "content": "§ \\_\\_repr\\_\\_ for repr()"
        },
        {
          "type": "text",
          "bbox": [
            0.354,
            0.235,
            0.419,
            0.246
          ],
          "content": "str(self.z) + ')'"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.249,
            0.282,
            0.263
          ],
          "content": "• Could get away with just one"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.252,
            0.386,
            0.265
          ],
          "content": "def \\_\\_repr\\_\\_(self):"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.263,
            0.264,
            0.275
          ],
          "content": "§ repr() requires \\_\\_repr\\_\\_"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.275,
            0.245,
            0.287
          ],
          "content": "§ str() can use \\_\\_repr\\_"
        },
        {
          "type": "text",
          "bbox": [
            0.314,
            0.264,
            0.455,
            0.275
          ],
          "content": "\"\"\"Returns: unambiguous string\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.144,
            0.285,
            0.261,
            0.299
          ],
          "content": "(if \\_\\_str\\_\\_ is not there)"
        },
        {
          "type": "text",
          "bbox": [
            0.314,
            0.275,
            0.429,
            0.287
          ],
          "content": "return str(self.\\_\\_class\\_\\_)+"
        },
        {
          "type": "text",
          "bbox": [
            0.341,
            0.288,
            0.382,
            0.3
          ],
          "content": "str(self)"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.6,
            0.124,
            0.823,
            0.143
          ],
          "level": 2,
          "content": "Making a Class into a Type"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.154,
            0.818,
            0.169
          ],
          "content": "1. Think about what values you want in the set"
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.17,
            0.836,
            0.185
          ],
          "content": "§ What are the attributes? What values can they have?"
        },
        {
          "type": "text",
          "bbox": [
            0.538,
            0.186,
            0.787,
            0.203
          ],
          "content": "2. Think about what operations you want"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.203,
            0.792,
            0.218
          ],
          "content": "§ This often influences the previous question"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.22,
            0.814,
            0.235
          ],
          "content": "• To make (1) precise: write a class invariant"
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.236,
            0.872,
            0.251
          ],
          "content": "§ Statement we promise to keep true **after every method call**"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.252,
            0.844,
            0.269
          ],
          "content": "• To make (2) precise: write method specifications"
        },
        {
          "type": "text",
          "bbox": [
            0.554,
            0.268,
            0.886,
            0.284
          ],
          "content": "§ Statement of what method does/what it expects (preconditions)"
        },
        {
          "type": "text",
          "bbox": [
            0.538,
            0.285,
            0.833,
            0.302
          ],
          "content": "• Write your code to make these statements true!"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.205,
            0.406,
            0.372,
            0.424
          ],
          "level": 2,
          "content": "Planning out a Class"
        },
