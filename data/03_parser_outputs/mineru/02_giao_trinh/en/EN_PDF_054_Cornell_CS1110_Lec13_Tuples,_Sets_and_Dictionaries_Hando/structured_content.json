          ],
          "content": "10/4/26"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.157,
            0.123,
            0.42,
            0.143
          ],
          "level": 2,
          "content": "Modifying the Contents of a List"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.117,
            0.151,
            0.254,
            0.168
          ],
          "level": 2,
          "content": "def add\\_one(thelist):"
        },
        {
          "type": "text",
          "bbox": [
            0.131,
            0.169,
            0.452,
            0.218
          ],
          "content": "\"\"\"(Procedure) Adds 1 to every element in the list Precondition: thelist is a list of all numbers (either floats or ints)\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.218,
            0.235,
            0.235
          ],
          "content": "for x in thelist:"
        },
        {
          "type": "equation",
          "bbox": [
            0.147,
            0.237,
            0.205,
            0.254
          ],
          "content": "\\mathbf {x} = \\mathbf {x} + 1",
          "image_source": "images/page_1_equation_6.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.266,
            0.229,
            0.422,
            0.249
          ],
          "content": "**DOES NOT WORK!**"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.256,
            0.286,
            0.275
          ],
          "content": "\\# procedure; no return"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.17,
            0.405,
            0.406,
            0.424
          ],
          "level": 2,
          "content": "How Can We Modify A List?"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.434,
            0.275,
            0.451
          ],
          "content": "• **Never** modify loop var!"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.451,
            0.273,
            0.468
          ],
          "content": "• This is an infinite loop:"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.434,
            0.452,
            0.451
          ],
          "content": "• Need a second sequence"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.451,
            0.458,
            0.469
          ],
          "content": "• How about the positions?"
        },
        {
          "type": "text",
          "bbox": [
            0.129,
            0.475,
            0.222,
            0.491
          ],
          "content": "for x in thelist:"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.474,
            0.42,
            0.493
          ],
          "content": "thelist = [5, 2, 7, 1]"
        },
        {
          "type": "text",
          "bbox": [
            0.144,
            0.492,
            0.247,
            0.509
          ],
          "content": "thelist.append(1)"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.49,
            0.421,
            0.509
          ],
          "content": "thepos = [0, 1, 2, 3]"
        },
        {
          "type": "text",
          "bbox": [
            0.139,
            0.521,
            0.264,
            0.539
          ],
          "content": "Try in Python Tutor"
        },
        {
          "type": "text",
          "bbox": [
            0.138,
            0.54,
            0.264,
            0.556
          ],
          "content": "to see what happens"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.522,
            0.399,
            0.54
          ],
          "content": "for x in thepos:"
        },
        {
          "type": "text",
          "bbox": [
            0.318,
            0.54,
            0.412,
            0.558
          ],
          "content": "thelist[x] = x + 1"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.208,
            0.686,
            0.368,
            0.705
          ],
          "level": 2,
          "content": "The Range Iterator"
        },
        {
          "type": "text",
          "bbox": [
            0.119,
            0.716,
            0.192,
            0.733
          ],
          "content": "• range(x)"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.734,
            0.261,
            0.749
          ],
          "content": "§ Creates an iterator"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.715,
            0.42,
            0.732
          ],
          "content": "• Very versatile tool"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.75,
            0.262,
            0.766
          ],
          "content": "§ Stores [0,1,…,x-1]"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.732,
            0.454,
            0.748
          ],
          "content": "• Great for <u>processing int</u>s"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.766,
            0.239,
            0.782
          ],
          "content": "§ **But not a list!**"
        },
        {
          "type": "text",
          "bbox": [
            0.135,
            0.781,
            0.272,
            0.798
          ],
          "content": "§ But try list(range(x))"
        },
        {
          "type": "text",
          "bbox": [
            0.363,
            0.751,
            0.447,
            0.767
          ],
          "content": "**Accumulator**"
        },
        {
          "type": "equation",
          "bbox": [
            0.306,
            0.766,
            0.36,
            0.782
          ],
          "content": "\\text {total} = 0",
          "image_source": "images/page_1_equation_31.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.119,
            0.8,
            0.203,
            0.816
          ],
          "content": "• range(a,b)"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.816,
            0.251,
            0.833
          ],
          "content": "§ Stores [a,…,b-1]"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.785,
            0.452,
            0.815
          ],
          "continues_prev": true,
          "content": "\\# add the squares of ints # in range 2..200 to total"
        },
        {
          "type": "text",
          "bbox": [
            0.119,
            0.834,
            0.214,
            0.85
          ],
          "content": "• range(a,b,n)"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.851,
            0.275,
            0.869
          ],
          "content": "§ Stores [a,a+n,…,b-1]"
        },
        {
          "type": "text",
          "bbox": [
            0.305,
            0.819,
            0.435,
            0.852
          ],
          "continues_prev": true,
          "content": "for x in range(2,201): total = total + x\\*x"
        },
        {
          "type": "page_number",
          "bbox": [
            0.525,
            0.331,
            0.539,
            0.345
          ],
          "content": "8"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.613,
            0.548,
            0.628
          ],
          "content": "10"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.628,
            0.124,
            0.795,
            0.142
          ],
          "level": 2,
          "content": "On The Other Hand"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.151,
            0.714,
            0.169
          ],
          "content": "def copy\\_add\\_one(thelist):"
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.169,
            0.861,
            0.186
          ],
          "content": "\"\"\"Returns: copy with 1 added to every element"
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.186,
            0.836,
            0.203
          ],
          "content": "Precondition: thelist is a list of all numbers"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.2,
            0.714,
            0.217
          ],
          "content": "(either floats or ints)\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.555,
            0.218,
            0.737,
            0.235
          ],
          "content": "mycopy = [] # accumulator"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.236,
            0.658,
            0.253
          ],
          "content": "for x in thelist:"
        },
        {
          "type": "text",
          "bbox": [
            0.702,
            0.238,
            0.826,
            0.254
          ],
          "content": "Accumulator keeps"
        },
        {
          "type": "equation",
          "bbox": [
            0.571,
            0.253,
            0.628,
            0.269
          ],
          "content": "\\mathbf {x} = \\mathbf {x} + 1",
          "image_source": "images/page_1_equation_48.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.698,
            0.252,
            0.831,
            0.267
          ],
          "content": "result from being lost"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.288,
            0.657,
            0.306
          ],
          "content": "return mycopy"
        },
        {
          "type": "text",
          "bbox": [
            0.57,
            0.27,
            0.879,
            0.289
          ],
          "content": "mycopy.append(x) # add to end of accumulator"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.57,
            0.405,
            0.852,
            0.424
          ],
          "level": 2,
          "content": "This is the Motivation for Iterables"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.435,
            0.683,
            0.45
          ],
          "content": "• **Iterables** are objects"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.45,
            0.689,
            0.465
          ],
          "content": "§ Contain data like a list"
        },
        {
          "type": "text",
          "bbox": [
            0.724,
            0.449,
            0.779,
            0.464
          ],
          "content": "seq **id1**"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.465,
            0.692,
            0.479
          ],
          "content": "§ **But cannot slice them**"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.48,
            0.702,
            0.495
          ],
          "content": "• Have list-like properties"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.495,
            0.706,
            0.509
          ],
          "content": "§ Can use then in a for-loop"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.508,
            0.702,
            0.523
          ],
          "content": "§ Can convert them to lists"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.522,
            0.694,
            0.538
          ],
          "content": "§ mylist = list(myiterable)"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.538,
            0.652,
            0.554
          ],
          "content": "• **Example**: Files"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.552,
            0.708,
            0.568
          ],
          "content": "§ Use open() to create object"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.567,
            0.708,
            0.583
          ],
          "content": "§ Makes iterable for reading"
        },
        {
          "type": "text",
          "bbox": [
            0.726,
            0.515,
            0.78,
            0.53
          ],
          "content": "alt **id2**"
        },
        {
          "type": "image",
          "bbox": [
            0.802,
            0.508,
            0.874,
            0.564
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_1_image_65.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.812,
            0.51,
            0.834,
            0.523
          ],
          "content": "**id2**"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.58,
            0.686,
            0.842,
            0.705
          ],
          "level": 2,
          "content": "Modifying the Contents of a List"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.54,
            0.713,
            0.678,
            0.73
          ],
          "level": 2,
          "content": "def add\\_one(thelist):"
        },
        {
          "type": "text",
          "bbox": [
            0.554,
            0.73,
            0.875,
            0.779
          ],
          "content": "\"\"\"(Procedure) Adds 1 to every element in the list Precondition: thelist is a list of all numbers (either floats or ints)\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.78,
            0.675,
            0.797
          ],
          "content": "size = len(thelist)"
        },
        {
          "type": "text",
          "bbox": [
            0.724,
            0.78,
            0.802,
            0.795
          ],
          "content": "Iterator of list"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.799,
            0.687,
            0.817
          ],
          "content": "for k in range(size):"
        },
        {
          "type": "text",
          "bbox": [
            0.719,
            0.793,
            0.804,
            0.807
          ],
          "content": "**positions** (safe)"
        },
        {
          "type": "text",
          "bbox": [
            0.571,
            0.818,
            0.725,
            0.835
          ],
          "content": "thelist[k] = thelist[k]+1"
        },
        {
          "type": "text",
          "bbox": [
            0.765,
            0.819,
            0.841,
            0.838
          ],
          "content": "**WORKS!**"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.836,
            0.709,
            0.854
          ],
          "content": "\\# procedure; no return"
        },
        {
          "type": "page_number",
