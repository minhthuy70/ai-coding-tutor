            0.516
          ],
          "content": "**Key Concepts**"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.521,
            0.394,
            0.538
          ],
          "content": "• **iterable**: seqn"
        },
        {
          "type": "text",
          "bbox": [
            0.291,
            0.538,
            0.409,
            0.555
          ],
          "content": "• **loop variable**: x"
        },
        {
          "type": "text",
          "bbox": [
            0.292,
            0.555,
            0.396,
            0.572
          ],
          "content": "• **body**: print(x)"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.119,
            0.686,
            0.458,
            0.705
          ],
          "level": 2,
          "content": "Example: Summing the Elements of a List"
        },
        {
          "type": "text",
          "bbox": [
            0.117,
            0.714,
            0.227,
            0.73
          ],
          "content": "def sum(thelist):"
        },
        {
          "type": "text",
          "bbox": [
            0.131,
            0.731,
            0.421,
            0.778
          ],
          "content": "\"\"\"Returns: the sum of all elements in thelist Precondition: thelist is a list of all numbers (either floats or ints)\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.778,
            0.202,
            0.795
          ],
          "content": "result = 0"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.779,
            0.325,
            0.804
          ],
          "content": "**Accumulator** variable"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.805,
            0.235,
            0.821
          ],
          "content": "for x in thelist:"
        },
        {
          "type": "text",
          "bbox": [
            0.285,
            0.803,
            0.411,
            0.819
          ],
          "content": "**iterable:** thelist"
        },
        {
          "type": "text",
          "bbox": [
            0.145,
            0.822,
            0.272,
            0.839
          ],
          "content": "result = result + x"
        },
        {
          "type": "text",
          "bbox": [
            0.286,
            0.82,
            0.415,
            0.837
          ],
          "content": "• **loop variable**: x"
        },
        {
          "type": "text",
          "bbox": [
            0.132,
            0.847,
            0.223,
            0.864
          ],
          "content": "return result"
        },
        {
          "type": "text",
          "bbox": [
            0.284,
            0.839,
            0.448,
            0.855
          ],
          "content": "<u>•</u> <strong><u>body</u></strong><u>: result=result+x</u>"
        },
        {
          "type": "page_number",
          "bbox": [
            0.526,
            0.332,
            0.538,
            0.345
          ],
          "content": "2"
