            0.452,
            0.279,
            0.466
          ],
          "content": "§ Write body for each loop"
        },
        {
          "type": "text",
          "bbox": [
            0.133,
            0.466,
            0.279,
            0.482
          ],
          "content": "§ Pick right body in update"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.484,
            0.282,
            0.499
          ],
          "content": "• **State**: Current loop body"
