            0.591,
            0.405,
            0.831,
            0.424
          ],
          "level": 2,
          "content": "How Do We Represent State?"
        },
        {
          "type": "text",
          "bbox": [
            0.642,
            0.245,
            0.684,
            0.261
          ],
          "content": "Draw"
