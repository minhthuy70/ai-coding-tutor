        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.451,
            0.675,
            0.465
          ],
          "content": "§ List of fixed values"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.465,
            0.685,
            0.479
          ],
          "content": "§ Each value a variable"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.478,
            0.695,
            0.493
          ],
          "content": "§ Variable is a state name"
        },
        {
          "type": "text",
          "bbox": [
            0.54,
            0.494,
            0.694,
            0.509
          ],
          "content": "• In Java/C this is a type"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.509,
            0.699,
            0.523
          ],
          "content": "§ But we use int in Python"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.522,
            0.7,
            0.536
          ],
          "content": "§ Achieves the same result"
        },
        {
          "type": "text",
          "bbox": [
            0.539,
            0.536,
            0.696,
            0.552
          ],
          "content": "• Affects state **invariant**"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.553,
            0.685,
            0.567
          ],
          "content": "§ Should not be any int"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.567,
            0.679,
            0.581
          ],
          "content": "§ Should be in the list"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.435,
            0.877,
            0.461
          ],
          "continues_prev": true,
          "content": "\\# state before the game has started STATE\\_INACTIVE = 0"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.465,
            0.866,
            0.478
          ],
          "content": "\\# state when loading a new wave"
        },
        {
          "type": "text",
          "bbox": [
            0.715,
            0.478,
            0.818,
            0.491
          ],
          "content": "STATE\\_LOADING = 1"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.495,
            0.864,
            0.521
          ],
          "content": "\\# state when the wave is in play STATE\\_ACTIVE = 2"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.523,
            0.865,
            0.55
          ],
          "content": "\\# state when we pause the game STATE\\_PAUSED = 3"
        },
        {
          "type": "text",
          "bbox": [
            0.714,
            0.552,
            0.872,
            0.578
          ],
          "content": "\\# state when the game is complete STATE\\_COMPLETE = 5"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.176,
            0.686,
            0.399,
            0.704
          ],
          "level": 2,
          "content": "When Do We Switch State?"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.716,
            0.359,
            0.733
          ],
          "content": "• We switch for one of two reasons"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.734,
            0.415,
            0.75
          ],
          "content": "§ Can be the result of an event (e.g. game over)"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.852,
            0.354,
            0.869
          ],
          "content": "§ Animated state.py at the beginning"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.75,
            0.418,
            0.766
          ],
          "content": "§ Can be the result of an input (e.g. a key press)"
        },
        {
          "type": "text",
          "bbox": [
            0.115,
            0.767,
            0.431,
            0.783
          ],
          "content": "• Checks for this at the start or end of update()"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.785,
            0.345,
            0.801
          ],
          "content": "§ At the **beginning** if **input driven**"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.835,
            0.347,
            0.852
          ],
          "content": "§ Refactored pig3.py is it at the end"
        },
        {
          "type": "text",
          "bbox": [
            0.134,
            0.801,
            0.309,
            0.816
          ],
          "content": "§ At the **end** if **event driven**"
        },
        {
          "type": "text",
          "bbox": [
            0.116,
            0.819,
            0.212,
            0.835
          ],
          "content": "• **Examples:**"
        },
        {
          "type": "image",
          "bbox": [
            0.351,
            0.789,
            0.44,
            0.855
          ],
          "content": "",
          "captions": [],
          "footnotes": [],
          "image_source": "images/page_1_image_64.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.646,
            0.686,
            0.777,
            0.705
          ],
          "level": 2,
          "content": "Checking Input"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.589,
            0.719,
            0.66,
            0.735
          ],
          "level": 2,
          "content": "Keyboard"
        },
        {
          "type": "text",
          "bbox": [
            0.541,
            0.742,
            0.649,
            0.757
          ],
          "content": "• is\\_key\\_down(key)"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.757,
            0.704,
            0.77
          ],
          "content": "§ Returns True if key is down"
        },
        {
          "type": "text",
          "bbox": [
            0.558,
            0.769,
            0.704,
            0.781
          ],
          "content": "§ key is a string ('a' or 'space')"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.78,
            0.705,
            0.793
          ],
          "content": "§ Empty string means any key"
        },
        {
          "type": "text",
          "bbox": [
            0.542,
            0.792,
            0.662,
            0.806
          ],
          "content": "• is\\_key\\_pressed(key)"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.805,
            0.702,
            0.819
          ],
          "content": "§ Returns True if key pressed"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.818,
            0.697,
            0.831
          ],
          "content": "§ key **not** down prev. frame"
        },
        {
          "type": "text",
          "bbox": [
            0.542,
            0.83,
            0.664,
            0.844
          ],
          "content": "• is\\_key\\_released(key)"
        },
        {
          "type": "text",
          "bbox": [
            0.556,
            0.844,
            0.704,
            0.857
          ],
          "content": "§ Returns True if key released"
        },
        {
          "type": "text",
          "bbox": [
            0.557,
            0.857,
            0.699,
            0.87
          ],
          "content": "§ key was down prev. frame"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.752,
            0.72,
            0.845,
            0.735
          ],
          "level": 2,
          "content": "Mouse/Touch"
        },
        {
          "type": "text",
          "bbox": [
            0.716,
            0.742,
            0.764,
            0.756
          ],
          "content": "• touch"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.756,
            0.876,
            0.77
          ],
          "content": "§ **Attribute** giving a position"
        },
        {
          "type": "text",
          "bbox": [
            0.732,
            0.769,
            0.866,
            0.781
          ],
          "content": "§ Stored as a Point2 object"
        },
        {
          "type": "page_number",
          "bbox": [
            0.102,
            0.613,
            0.116,
            0.627
          ],
          "content": "9"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.78,
            0.849,
            0.794
          ],
          "content": "§ But None if no touch"
        },
        {
          "type": "text",
          "bbox": [
            0.717,
            0.792,
            0.829,
            0.806
          ],
          "content": "• is\\_touch\\_pressed()"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.805,
            0.849,
            0.819
          ],
          "content": "§ True if touch pressed"
        },
        {
          "type": "text",
          "bbox": [
            0.73,
            0.818,
            0.879,
            0.832
          ],
          "content": "§ touch was None prev. frame"
        },
        {
          "type": "text",
          "bbox": [
            0.717,
            0.83,
            0.832,
            0.844
          ],
          "content": "• is\\_touch\\_released()"
        },
        {
          "type": "text",
          "bbox": [
            0.73,
            0.843,
            0.852,
            0.857
          ],
          "content": "§ True if touch released"
        },
        {
          "type": "text",
          "bbox": [
            0.731,
            0.856,
            0.876,
            0.87
          ],
          "content": "§ touch **not** None prev. frame"
        },
        {
