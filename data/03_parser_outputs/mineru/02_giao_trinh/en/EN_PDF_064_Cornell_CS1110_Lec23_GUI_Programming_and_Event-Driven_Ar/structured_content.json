          "type": "text",
          "bbox": [
            0.321,
            0.207,
            0.429,
            0.233
          ],
          "content": "Loop initialization Do NOT use \\_\\_init\\_"
        },
        {
          "type": "text",
          "bbox": [
            0.142,
            0.235,
            0.302,
            0.249
          ],
          "content": "\"\"\"Changes the ellipse position.\"\"\""
        },
