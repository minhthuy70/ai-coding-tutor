          "type": "text",
          "bbox": [
            0.141,
            0.192,
            0.289,
            0.206
          ],
          "content": "\"\"\"Initializes the game loop.\"\"\""
        },
        {
          "type": "text",
          "bbox": [
            0.128,
            0.222,
            0.226,
            0.237
          ],
          "content": "def update(self,dt):"
