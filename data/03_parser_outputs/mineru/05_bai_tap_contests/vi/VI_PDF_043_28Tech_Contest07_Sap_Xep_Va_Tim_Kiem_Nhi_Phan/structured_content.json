          "level": 1,
          "content": "[Sắp xếp - Tìm Kiểm]. Bài 24. Biểu thức nhỏ nhất"
        },
        {
          "type": "text",
          "bbox": [
            0.289,
            0.237,
            0.324,
            0.257
          ],
          "content": "Problem"
        },
        {
          "type": "text",
          "bbox": [
            0.366,
            0.237,
            0.415,
            0.257
          ],
          "content": "Submissions"
        },
        {
          "type": "text",
          "bbox": [
            0.457,
            0.237,
            0.504,
            0.257
          ],
          "content": "Discussions"
        },
        {
          "type": "text",
          "bbox": [
            0.27,
            0.309,
            0.727,
            0.455
          ],
          "content": "Một đầy gồm n số nguyên không âm a1, a2,..., an được viết thành một hàng ngang, giữa hai số liên tiếp có một khoảng trắng, như vậy có tất cả (n-1) khoảng trắng. Người ta muốn đặt k dấu cộng và (n-1-k) dấu trừ vào (n-1) khoảng trắng đó để nhận được một biểu thức có giá trị lớn nhất. Ví dụ, với đầy gồm 5 số nguyên 28, 9, 5, 1, 69 và k = 2 thì cách đặt 28+9-5-1+69 là biểu thức có giá trị lớn nhất. Yêu cầu: Cho đầy gồm n số nguyên không âm a1, a2,..., an và số nguyên dương k, hấy tìm cách đặt k dấu cộng và (n-1-k) dấu trừ vào (n-1) khoảng trắng để nhận được một biểu thức có giá trị lớn nhất."
        },
        {
          "type": "text",
          "bbox": [
            0.271,
            0.468,
            0.329,
            0.493
          ],
          "content": "Input Format"
        },
        {
          "type": "text",
          "bbox": [
            0.271,
            0.505,
            0.674,
            0.533
          ],
          "content": "Dòng đầu chứa hai số nguyên dương n, k; Dòng thứ hai chứa n số nguyên không âm a1, a2,..., an;"
        },
        {
          "type": "text",
          "bbox": [
            0.272,
            0.547,
            0.322,
            0.569
          ],
          "content": "Constraints"
        },
        {
          "type": "text",
          "bbox": [
            0.272,
            0.585,
            0.409,
            0.61
          ],
          "content": "1<= k < n ≤ 10^5; 0 <= a[i] ≤ 10^6"
        },
        {
          "type": "text",
          "bbox": [
            0.272,
            0.625,
            0.337,
            0.649
          ],
          "content": "Output Format"
