          ],
          "content": "\\begin{array}{l} \\text {a, b, c = 100, 200, 300} \\\\ \\text {sum = a + b + c} \\\\ \\text {print(sum)} \\\\ \\text {tich = a * b * c} \\\\ \\text {print(tich)} \\end{array}",
          "image_source": "images/page_5_equation_6.jpg"
