          ],
          "content": "class Student(Person): def \\_\\_init\\_\\_(self, name, birth, gpa): super().\\_\\_init\\_\\_(name, birth) self.gpa = gpa"
        },
        {
          "type": "text",
          "bbox": [
            0.089,
            0.781,
            0.466,
