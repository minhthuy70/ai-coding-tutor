        {
          "type": "text",
          "bbox": [
            0.101,
            0.219,
            0.89,
            0.277
          ],
          "content": "Bạn cũng thể gọi hàm của lớp cha ở lớp con thông qua **từ khóa super()**"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.475,
            0.297,
            0.554,
            0.357
          ],
          "level": 2,
          "content": "VÍ DỤ:"
        },
        {
          "type": "text",
          "bbox": [
            0.249,
            0.401,
            0.582,
            0.541
          ],
          "content": "class Person: def \\_\\_init\\_\\_(self, name, birth): self.name = name self.birth = birth"
        },
        {
          "type": "text",
          "bbox": [
            0.248,
            0.542,
            0.455,
            0.578
          ],
          "content": "class Student(Person):"
        },
        {
          "type": "text",
          "bbox": [
            0.282,
            0.576,
            0.628,
            0.685
          ],
          "content": "def \\_\\_init\\_\\_(self, name, birth, gpa): super().\\_\\_init\\_\\_(name, birth) self.gpa = gpa"
        },
        {
          "type": "text",
          "bbox": [
            0.718,
            0.539,
            0.799,
            0.579
          ],
          "content": "**OUTPUT**"
        },
        {
          "type": "text",
          "bbox": [
            0.654,
            0.597,
            0.863,
            0.64
          ],
          "content": "28tech 01/01/2022 2.50"
        },
        {
          "type": "text",
          "bbox": [
            0.283,
            0.684,
            0.774,
            0.76
          ],
          "content": "def display(self): print(f'{self.name} {self.birth} {self.gpa:.2f}')"
        },
        {
          "type": "text",
          "bbox": [
            0.247,
            0.755,
            0.656,
            0.867
          ],
          "content": "if \\_\\_name == main s = Student('28tech', '01/01/2022', 2.5) s.display()"
        },
