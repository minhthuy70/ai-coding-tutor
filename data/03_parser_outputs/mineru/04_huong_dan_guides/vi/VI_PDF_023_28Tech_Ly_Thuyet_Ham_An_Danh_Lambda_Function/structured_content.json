        {
          "type": "text",
          "bbox": [
            0.093,
            0.254,
            0.447,
            0.391
          ],
          "content": "**Hàm map()** trong Python có 2 đối số là một hàm và 1 list, map áp dụng hàm này với các phần tử trong list."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.042,
            0.427,
            0.108,
            0.496
          ],
          "level": 2,
          "content": "00 mbda là"
        },
        {
          "type": "text",
          "bbox": [
            0.052,
            0.501,
            0.078,
            0.529
          ],
          "content": "00"
        },
        {
          "type": "equation",
          "bbox": [
            0.061,
            0.529,
            0.429,
            0.65
          ],
          "content": "\\begin{array}{l} \\text {a = [1, 2, 3, 4, 5]} \\\\ \\text {b = list(map(lambda x : x ** 2, a))} \\\\ \\text {print(b)} \\end{array}",
          "image_source": "images/page_7_equation_8.jpg"
        },
        {
