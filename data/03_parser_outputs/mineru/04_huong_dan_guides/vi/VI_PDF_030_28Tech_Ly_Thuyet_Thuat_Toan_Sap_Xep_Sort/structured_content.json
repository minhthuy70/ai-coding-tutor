          "type": "text",
          "bbox": [
            0.076,
            0.415,
            0.3,
            0.661
          ],
          "content": "def sumDigit(n):\n    res = 0\n    while n != 0 :\n        res += n % 10\n        n //= 10\n    return res"
        },
        {
          "type": "text",
          "bbox": [
            0.3,
            0.579,
            0.519,
            0.669
          ],
          "content": "**OUTPUT** [3, 111, 30, 12, 21, 32, 24, 99]"
        },
        {
          "type": "text",
          "bbox": [
            0.074,
            0.695,
            0.493,
            0.861
          ],
          "content": "if \\_\\_name\\_\\_ == '\\_\\_main\\_\\_':\n    a = [3, 24, 111, 30, 12, 21, 99, 32]\n    a.sort(key = sumDigit)\n    print(a)"
        },
