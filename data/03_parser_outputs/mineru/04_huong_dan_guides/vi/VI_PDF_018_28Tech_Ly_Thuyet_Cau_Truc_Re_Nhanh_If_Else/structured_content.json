        },
        {
          "type": "text",
          "bbox": [
            0.187,
            0.223,
            0.811,
            0.451
          ],
          "content": "Từ khóa elif (else if) trong python được sử dụng bên dưới if để kiểm tra thêm điều kiện bổ sung nếu điều kiện bên bên trên sai. Các điều kiện ở bên trong if và elif nếu đúng thì khối code tương ứng sẽ được thực thi, nếu không có điều kiện nào đúng thì khối lệnh bên trong else được thực thi."
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.169,
            0.493,
            0.269,
            0.547
          ],
          "level": 2,
          "content": "Cú pháp"
        },
        {
          "type": "text",
          "bbox": [
            0.124,
            0.559,
            0.295,
            0.718
          ],
          "content": "if condition1: #code1 elif condition2: #code2"
        },
        {
          "type": "text",
          "bbox": [
            0.124,
            0.755,
            0.296,
            0.918
          ],
          "content": "elif conditionN: #codeN else: #codeElse"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.385,
            0.483,
            0.455,
            0.559
          ],
          "level": 2,
          "content": "00 EXAMPLE"
        },
        {
          "type": "text",
          "bbox": [
            0.395,
            0.561,
            0.423,
            0.591
          ],
          "content": "0"
        },
        {
          "type": "text",
          "bbox": [
            0.418,
            0.586,
            0.746,
            0.875
          ],
          "content": "a, b = 100, 200 if a < b : print(a, 'less than', b) elif a == b: print(a, 'equal to', b) else: print(a, 'greater than', b)"
        },
        {
          "type": "text",
          "bbox": [
            0.787,
            0.673,
            0.869,
            0.715
          ],
          "content": "**OUTPUT**"
        },
        {
          "type": "text",
          "bbox": [
            0.751,
            0.725,
            0.906,
            0.767
          ],
          "content": "100 less than 200"
        },
        {
