            0.423
          ],
          "content": "**Kết hợp hàm với list comprehension:**"
        },
        {
          "type": "text",
          "bbox": [
            0.544,
            0.428,
            0.714,
            0.472
          ],
          "content": "def digitSum(n):"
        },
        {
          "type": "equation",
          "bbox": [
            0.586,
            0.473,
            0.666,
            0.508
          ],
          "content": "\\text {sum} = \\theta",
          "image_source": "images/page_5_equation_15.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.585,
            0.509,
            0.725,
            0.549
          ],
          "content": "while n != 0:"
        },
        {
          "type": "equation",
          "bbox": [
            0.626,
            0.549,
            0.768,
            0.589
          ],
          "content": "\\text {sum} + = n \\% 10",
          "image_source": "images/page_5_equation_17.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.813,
            0.547,
            0.893,
            0.587
          ],
          "content": "**OUTPUT**"
        },
        {
          "type": "equation",
          "bbox": [
            0.626,
            0.591,
            0.717,
            0.63
          ],
          "content": "n / / = 1 0",
          "image_source": "images/page_5_equation_19.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.805,
            0.592,
            0.898,
            0.635
          ],
          "content": "[6, 4, 2, 8, 6]"
        },
        {
          "type": "text",
          "bbox": [
            0.585,
            0.633,
            0.697,
            0.671
          ],
          "content": "return sum"
        },
        {
          "type": "text",
          "bbox": [
            0.544,
            0.707,
            0.83,
            0.752
          ],
          "content": "$a = [123, 31, 20, 503, 114]$"
        },
        {
          "type": "text",
          "bbox": [
            0.544,
            0.75,
            0.839,
            0.793
          ],
          "content": "b = [digitSum(x) for x in a]"
