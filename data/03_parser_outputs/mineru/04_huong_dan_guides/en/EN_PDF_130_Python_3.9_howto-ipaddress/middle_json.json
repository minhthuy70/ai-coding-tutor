            0.118,
            0.278,
            0.393,
            0.293
          ],
          "content": [
            {
              "type": "text",
              "content": "Obtaining the network from an interface:"
            }
          ]
        },
        {
          "type": "code",
          "index": 5,
          "bbox": [
            0.115,
            0.301,
            0.589,
            0.384
          ],
          "content": [
            {
              "type": "code_body",
              "index": 5,
              "bbox": [
                0.115,
                0.301,
                0.589,
                0.384
              ],
              "content": ">>> host4 = ipaddress.ip_interface('192.0.2.1/24')\n>>> host4.network\nIPv4Network('192.0.2.0/24')\n>>> host6 = ipaddress.ip_interface('2001:db8::1/96')\n>>> host6.network\nIPv6Network('2001:db8::/96')"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.395,
            0.522,
            0.412
          ],
          "content": [
            {
              "type": "text",
              "content": "Finding out how many individual addresses are in a network:"
            }
          ]
        },
        {
          "type": "code",
          "index": 7,
          "bbox": [
            0.115,
            0.419,
            0.563,
            0.501
          ],
          "content": [
            {
              "type": "code_body",
              "index": 7,
              "bbox": [
                0.115,
                0.419,
                0.563,
                0.501
              ],
              "content": ">>> net4 = ipaddress.ip_network('192.0.2.0/24')\n>>> net4.num_addresses\n256\n>>> net6 = ipaddress.ip_network('2001:db8::0/96')\n>>> net6.num_addresses\n4294967296"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.118,
            0.514,
            0.477,
            0.53
          ],
          "content": [
            {
              "type": "text",
              "content": "Iterating through the “usable” addresses on a network:"
            }
          ]
        },
        {
          "type": "code",
          "index": 9,
          "bbox": [
            0.116,
            0.537,
            0.545,
            0.685
          ],
          "content": [
            {
              "type": "code_body",
              "index": 9,
              "bbox": [
                0.116,
                0.537,
                0.545,
                0.685
              ],
              "content": ">>> net4 = ipaddress.ip_network('192.0.2.0/24')\n>>> for x in net4.hosts():\n...     print(x)\n192.0.2.1\n192.0.2.2\n192.0.2.3\n192.0.2.4\n...\n192.0.2.252\n192.0.2.253\n192.0.2.254"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.117,
            0.697,
            0.881,
            0.727
          ],
          "content": [
            {
              "type": "text",
              "content": "Obtaining the netmask (i.e. set bits corresponding to the network prefix) or the hostmask (any bits that are not part of the netmask):"
            }
          ]
        },
        {
          "type": "code",
          "index": 11,
          "bbox": [
            0.116,
            0.735,
            0.562,
            0.869
          ],
          "content": [
            {
              "type": "code_body",
              "index": 11,
              "bbox": [
                0.116,
                0.735,
                0.562,
                0.869
              ],
              "content": ">>> net4 = ipaddress.ip_network('192.0.2.0/24')\n>>> net4.netmask\nIPv4Address('255.255.255.0')\n>>> net4.hostmask\nIPv4Address('0.0.0.255')\n>>> net6 = ipaddress.ip_network('2001:db8::0/96')\n>>> net6.netmask\nIPv6Address('ffff:ffff:ffff:ffff:ffff:ffff::')\n>>> net6.hostmask\nIPv6Address('::ffff:ffff')"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.118,
            0.882,
            0.377,
            0.898
          ],
          "content": [
            {
              "type": "text",
              "content": "Exploding or compressing the address:"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 13,
          "bbox": [
            0.493,
            0.939,
            0.506,
            0.951
          ],
          "content": [
            {
              "type": "text",
              "content": "4"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 4,
      "blocks": [
        {
          "type": "code",
          "index": 0,
          "bbox": [
            0.117,
            0.091,
            0.518,
            0.2
          ],
          "content": [
            {
              "type": "code_body",
              "index": 0,
              "bbox": [
                0.117,
                0.091,
                0.518,
                0.2
              ],
              "content": ">>> addr6.exploded\n'2001:0db8:0000:0000:0000:0000:0000:0001'\n>>> addr6.compressed\n'2001:db8::1'\n>>> net6.exploded\n'2001:0db8:0000:0000:0000:0000:0000:0000/96'\n>>> net6.compressed\n'2001:db8::/96'"
            }
          ],
          "sub_type": "code",
          "guess_lang": "srt"
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.116,
            0.212,
            0.882,
            0.257
          ],
          "content": [
            {
              "type": "text",
              "content": "While IPv4 doesn’t support explosion or compression, the associated objects still provide the relevant properties so that version neutral code can easily ensure the most concise or most verbose form is used for IPv6 addresses while still correctly handling IPv4 addresses."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.117,
            0.284,
            0.503,
            0.304
          ],
          "content": [
            {
              "type": "text",
              "content": "3 Networks as lists of Addresses"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.117,
            0.323,
            0.747,
            0.339
          ],
          "content": [
            {
              "type": "text",
              "content": "It’s sometimes useful to treat networks as lists. This means it is possible to index them like this:"
            }
          ]
        },
        {
          "type": "code",
          "index": 4,
          "bbox": [
            0.116,
            0.346,
            0.426,
            0.454
          ],
          "content": [
            {
              "type": "code_body",
              "index": 4,
              "bbox": [
                0.116,
                0.346,
                0.426,
                0.454
              ],
              "content": ">>> net4[1]\nIPv4Address('192.0.2.1')\n>>> net4[-1]\nIPv4Address('192.0.2.255')\n>>> net6[1]\nIPv6Address('2001:db8::1')\n>>> net6[-1]\nIPv6Address('2001:db8::ffff:ffff')"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.117,
            0.467,
            0.778,
            0.483
          ],
          "content": [
            {
              "type": "text",
              "content": "It also means that network objects lend themselves to using the list membership test syntax like this:"
            }
          ]
        },
        {
          "type": "code",
          "index": 6,
          "bbox": [
            0.116,
            0.491,
            0.319,
            0.521
          ],
          "content": [
            {
              "type": "code_body",
              "index": 6,
              "bbox": [
                0.116,
                0.491,
                0.319,
                0.521
              ],
              "content": "if address in network:\n    # do something"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.118,
            0.533,
            0.565,
            0.549
          ],
          "content": [
            {
              "type": "text",
              "content": "Containment testing is done efficiently based on the network prefix:"
            }
          ]
        },
        {
          "type": "code",
          "index": 8,
          "bbox": [
            0.116,
            0.557,
            0.563,
            0.626
          ],
          "content": [
            {
              "type": "code_body",
              "index": 8,
              "bbox": [
                0.116,
                0.557,
                0.563,
                0.626
              ],
              "content": ">>> addr4 = ipaddress.ip_address('192.0.2.1')\n>>> addr4 in ipaddress.ip_network('192.0.2.0/24')\nTrue\n>>> addr4 in ipaddress.ip_network('192.0.3.0/24')\nFalse"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.117,
            0.66,
            0.3,
            0.68
          ],
          "content": [
            {
              "type": "text",
              "content": "4 Comparisons"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.119,
            0.699,
            0.803,
            0.715
          ],
          "content": [
            {
              "type": "text",
              "content": "ipaddress provides some simple, hopefully intuitive ways to compare objects, where it makes sense:"
            }
          ]
        },
        {
          "type": "code",
          "index": 11,
          "bbox": [
            0.117,
            0.723,
            0.778,
            0.752
          ],
          "content": [
            {
              "type": "code_body",
              "index": 11,
              "bbox": [
                0.117,
                0.723,
                0.778,
                0.752
              ],
              "content": ">>> ipaddress.ip_address('192.0.2.1') < ipaddress.ip_address('192.0.2.2')\nTrue"
            }
          ],
          "sub_type": "code",
          "guess_lang": "html"
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.118,
            0.766,
            0.804,
            0.781
          ],
          "content": [
            {
              "type": "text",
              "content": "A TypeError exception is raised if you try to compare objects of different versions or different types."
            }
          ]
        },
        {
          "type": "page_number",
          "index": 13,
          "bbox": [
            0.493,
            0.939,
            0.506,
            0.951
          ],
          "content": [
            {
              "type": "text",
              "content": "5"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.116,
            0.085,
            0.6,
            0.105
          ],
          "content": [
            {
              "type": "text",
              "content": "5 Using IP Addresses with other modules"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.115,
            0.124,
            0.88,
            0.155
          ],
          "content": [
            {
              "type": "text",
              "content": "Other modules that use IP addresses (such as socket) usually won’t accept objects from this module directly. Instead, they must be coerced to an integer or string that the other module will accept:"
            }
          ]
        },
        {
          "type": "code",
          "index": 2,
          "bbox": [
            0.115,
            0.161,
            0.527,
            0.23
          ],
          "content": [
            {
              "type": "code_body",
              "index": 2,
              "bbox": [
                0.115,
                0.161,
                0.527,
                0.23
              ],
              "content": ">>> addr4 = ipaddress.ip_address('192.0.2.1')\n>>> str(addr4)\n'192.0.2.1'\n>>> int(addr4)\n3221225985"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
            0.116,
            0.265,
            0.692,
            0.286
          ],
          "content": [
            {
              "type": "text",
              "content": "6 Getting more detail when instance creation fails"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.115,
            0.304,
            0.883,
            0.363
          ],
          "content": [
            {
              "type": "text",
              "content": "When creating address/network/interface objects using the version-agnostic factory functions, any errors will be reported as ValueError with a generic error message that simply says the passed in value was not recognized as an object of that type. The lack of a specific error is because it’s necessary to know whether the value is supposed to be IPv4 or IPv6 in order to provide more detail on why it has been rejected."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.115,
            0.369,
            0.881,
            0.413
          ],
          "content": [
            {
              "type": "text",
              "content": "To support use cases where it is useful to have access to this additional detail, the individual class constructors actually raise the ValueError subclasses ipaddress.AddressValueError and ipaddress. NetmaskValueError to indicate exactly which part of the definition failed to parse correctly."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.117,
            0.418,
            0.825,
            0.434
          ],
          "content": [
            {
              "type": "text",
              "content": "The error messages are significantly more detailed when using the class constructors directly. For example:"
            }
          ]
        },
        {
          "type": "code",
          "index": 7,
          "bbox": [
            0.116,
            0.44,
            0.835,
            0.667
          ],
          "content": [
            {
              "type": "code_body",
              "index": 7,
              "bbox": [
                0.116,
                0.44,
                0.835,
                0.667
              ],
              "content": ">>> ipaddress.ip_address(\"192.168.0.256\")\nTraceback (most recent call last):\n  ...\nValueError: '192.168.0.256' does not appear to be an IPv4 or IPv6 address\n>>> ipaddress.IPv4Address(\"192.168.0.256\")\nTraceback (most recent call last):\n  ...\nipaddress.AddressValueError: Octet 256 (> 255) not permitted in '192.168.0.256'\n\n>>> ipaddress.ip_network(\"192.168.0.1/64\")\nTraceback (most recent call last):\n  ...\nValueError: '192.168.0.1/64' does not appear to be an IPv4 or IPv6 network\n>>> ipaddress.IPv4Network(\"192.168.0.1/64\")\nTraceback (most recent call last):\n  ...\nipaddress.NetmaskValueError: '64' is not a valid netmask"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.116,
            0.68,
            0.881,
            0.71
          ],
          "content": [
            {
              "type": "text",
              "content": "However, both of the module specific exceptions have ValueError as their parent class, so if you’re not concerned with the particular type of error, you can still write code like the following:"
            }
          ]
        },
        {
          "type": "code",
          "index": 9,
          "bbox": [
            0.116,
            0.717,
            0.644,
            0.773
          ],
          "content": [
            {
              "type": "code_body",
              "index": 9,
              "bbox": [
                0.116,
                0.717,
                0.644,
                0.773
              ],
              "content": "try:\n    network = ipaddress.IPv4Network(address)\nexcept ValueError:\n    print('address/netmask is invalid for IPv4:', address)"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "page_number",
          "index": 10,
          "bbox": [
            0.493,
            0.939,
            0.506,
            0.952
          ],
          "content": [
            {
              "type": "text",
              "content": "6"
            }
          ]
        }
      ]
    }
