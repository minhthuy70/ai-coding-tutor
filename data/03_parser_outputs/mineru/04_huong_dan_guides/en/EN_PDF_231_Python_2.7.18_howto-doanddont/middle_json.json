            0.124,
            0.714,
            0.189,
            0.73
          ],
          "content": [
            {
              "type": "text",
              "content": "Abstract"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.121,
            0.744,
            0.875,
            0.778
          ],
          "content": [
            {
              "type": "text",
              "content": "This document can be considered a companion to the tutorial. It shows how to use Python, and even more importantly, how not to use Python."
            }
          ]
        },
        {
          "type": "page_number",
          "index": 11,
          "bbox": [
            0.494,
            0.936,
            0.505,
            0.949
          ],
          "content": [
            {
              "type": "text",
              "content": "1"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.114,
            0.09,
            0.621,
            0.112
          ],
          "content": [
            {
              "type": "text",
              "content": "1 Language Constructs You Should Not Use"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.112,
            0.132,
            0.885,
            0.164
          ],
          "content": [
            {
              "type": "text",
              "content": "While Python has relatively few gotchas compared to other languages, it still has some constructs which are only useful in corner cases, or are plain dangerous."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 2,
          "bbox": [
            0.114,
            0.189,
            0.356,
            0.207
          ],
          "content": [
            {
              "type": "text",
              "content": "1.1 from module import *"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 3,
          "bbox": [
            0.113,
            0.224,
            0.331,
            0.24
          ],
          "content": [
            {
              "type": "text",
              "content": "Inside Function Definitions"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.112,
            0.255,
            0.886,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": "from module import * is invalid inside function definitions. While many versions of Python do not check for the invalidity, it does not make it more valid, no more than having a smart lawyer makes a man innocent. Do not use it like that ever. Even in versions where it was accepted, it made the function execution slower, because the compiler could not be certain which names were local and which were global. In Python 2.1 this construct causes warnings, and sometimes even errors."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.114,
            0.356,
            0.246,
            0.372
          ],
          "content": [
            {
              "type": "text",
              "content": "At Module Level"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.112,
            0.388,
            0.886,
            0.449
          ],
          "content": [
            {
              "type": "text",
              "content": "While it is valid to use from module import * at module level it is usually a bad idea. For one, this loses an important property Python otherwise has — you can know where each toplevel name is defined by a simple “search” function in your favourite editor. You also open yourself to trouble in the future, if some module grows additional functions or classes."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.114,
            0.456,
            0.593,
            0.472
          ],
          "content": [
            {
              "type": "text",
              "content": "One of the most awful questions asked on the newsgroup is why this code:"
            }
          ]
        },
        {
          "type": "code",
          "index": 8,
          "bbox": [
            0.114,
            0.481,
            0.248,
            0.511
          ],
          "content": [
            {
              "type": "code_body",
              "index": 8,
              "bbox": [
                0.114,
                0.481,
                0.248,
                0.511
              ],
              "content": "f = open(\"www\")\nf.read()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.112,
            0.526,
            0.885,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "does not work. Of course, it works just fine (assuming you have a file called “www”.) But it does not work if somewhere in the module, the statement from os import * is present. The os module has a function called open() which returns an integer. While it is very useful, shadowing a builtin is one of its least useful properties."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.112,
            0.579,
            0.885,
            0.625
          ],
          "content": [
            {
              "type": "text",
              "content": "Remember, you can never know for sure what names a module exports, so either take what you need — from module import name1, name2, or keep them in the module and access on a per-need basis — import module; print module.name."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.114,
            0.65,
            0.276,
            0.665
          ],
          "content": [
            {
              "type": "text",
              "content": "When It Is Just Fine"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.113,
            0.681,
            0.578,
            0.696
          ],
          "content": [
            {
              "type": "text",
              "content": "There are situations in which from module import * is just fine:"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.139,
            0.705,
            0.881,
            0.72
          ],
          "content": [
            {
              "type": "text",
              "content": "- The interactive prompt. For example, from math import * makes Python an amazing scientific calculator."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.139,
            0.727,
            0.525,
            0.742
          ],
          "content": [
            {
              "type": "text",
              "content": "- When extending a module in C with a module in Python."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.139,
            0.75,
            0.559,
            0.765
          ],
          "content": [
            {
              "type": "text",
              "content": "- When the module advertises itself as from import * safe."
            }
          ]
        },
        {
          "type": "page_number",
          "index": 16,
          "bbox": [
            0.492,
            0.935,
            0.506,
            0.949
          ],
          "content": [
            {
              "type": "text",
              "content": "2"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 2,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.114,
            0.09,
            0.553,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "1.2 Unadorned exec, execfile() and friends"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.112,
            0.123,
            0.886,
            0.17
          ],
          "content": [
            {
              "type": "text",
              "content": "The word “unadorned” refers to the use without an explicit dictionary, in which case those constructs evaluate code in the current environment. This is dangerous for the same reasons from import * is dangerous — it might step over variables you are counting on and mess up things for the rest of your code. Simply do not do that."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.114,
            0.176,
            0.213,
            0.191
          ],
          "content": [
            {
              "type": "text",
              "content": "Bad examples:"
            }
          ]
        },
        {
          "type": "code",
          "index": 3,
          "bbox": [
            0.112,
            0.2,
            0.514,
            0.303
          ],
          "content": [
            {
              "type": "code_body",
              "index": 3,
              "bbox": [
                0.112,
                0.2,
                0.514,
                0.303
              ],
              "content": ">>> for name in sys.argv[1:]:\n>>>     exec \"%s=1\" % name\n>>> def func(s, **kw):\n>>>     for var, val in kw.items():\n>>>         exec \"s.%s=val\" % var  # invalid!\n>>> execfile(\"handler.py\")\n>>> handle()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.115,
            0.315,
            0.222,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": "Good examples:"
            }
          ]
        },
        {
          "type": "code",
          "index": 5,
          "bbox": [
            0.112,
            0.339,
            0.426,
            0.484
          ],
          "content": [
            {
              "type": "code_body",
              "index": 5,
              "bbox": [
                0.112,
                0.339,
                0.426,
                0.484
              ],
              "content": ">>> d = {}\n>>> for name in sys.argv[1:]:\n>>>     d[name] = 1\n>>> def func(s, **kw):\n>>>     for var, val in kw.items():\n>>>         setattr(s, var, val)\n>>> d={}\n>>> execfile(\"handle.py\", d, d)\n>>> handle = d['handle']\n>>> handle()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "paragraph_title",
          "index": 6,
          "bbox": [
            0.114,
            0.515,
            0.484,
            0.533
          ],
          "content": [
            {
              "type": "text",
              "content": "1.3 from module import name1, name2"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.112,
            0.548,
            0.886,
            0.624
          ],
          "content": [
            {
              "type": "text",
              "content": "This is a “don’t” which is much weaker than the previous “don’t”s but is still something you should not do if you don’t have good reasons to do that. The reason it is usually a bad idea is because you suddenly have an object which lives in two separate namespaces. When the binding in one namespace changes, the binding in the other will not, so there will be a discrepancy between them. This happens when, for example, one module is reloaded, or changes the definition of a function at runtime."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.114,
            0.631,
            0.206,
            0.647
          ],
          "content": [
            {
              "type": "text",
              "content": "Bad example:"
            }
          ]
        },
        {
          "type": "code",
          "index": 9,
          "bbox": [
            0.112,
            0.655,
            0.384,
            0.758
          ],
          "content": [
            {
              "type": "code_body",
              "index": 9,
              "bbox": [
                0.112,
                0.655,
                0.384,
                0.758
              ],
              "content": "# foo.py\na = 1\n\n# bar.py\nfrom foo import a\nif something():\n    a = 2 # danger: foo.a != a"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.115,
            0.77,
            0.216,
            0.787
          ],
          "content": [
            {
              "type": "text",
              "content": "Good example:"
            }
          ]
        },
        {
          "type": "code",
          "index": 11,
          "bbox": [
            0.113,
            0.795,
            0.25,
            0.897
          ],
          "content": [
            {
              "type": "code_body",
              "index": 11,
              "bbox": [
                0.113,
                0.795,
                0.25,
                0.897
              ],
              "content": "# foo.py\na = 1\n\n# bar.py\nimport foo\nif something():\n    foo.a = 2"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "page_number",
          "index": 12,
          "bbox": [
            0.493,
            0.935,
            0.506,
            0.949
          ],
          "content": [
            {
              "type": "text",
              "content": "3"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 3,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.115,
            0.09,
            0.225,
            0.109
          ],
          "content": [
            {
              "type": "text",
              "content": "1.4 except:"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.112,
            0.123,
            0.885,
            0.155
          ],
          "content": [
            {
              "type": "text",
              "content": "Python has the except: clause, which catches all exceptions. Since every error in Python raises an exception, using except: can make many programming errors look like runtime problems, which hinders the debugging process."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.114,
            0.16,
            0.512,
            0.177
          ],
          "content": [
            {
              "type": "text",
              "content": "The following code shows a great example of why this is bad:"
            }
          ]
        },
        {
          "type": "code",
          "index": 3,
          "bbox": [
            0.113,
            0.185,
            0.489,
            0.245
          ],
          "content": [
            {
              "type": "code_body",
              "index": 3,
              "bbox": [
                0.113,
                0.185,
                0.489,
                0.245
              ],
              "content": "try:\n    foo = opne(\"file\") # misspelled \"open\"\nexcept:\n    sys.exit(\"could not open file!\")"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.112,
            0.258,
            0.886,
            0.305
          ],
          "content": [
            {
              "type": "text",
              "content": "The second line triggers a NameError, which is caught by the except clause. The program will exit, and the error message the program prints will make you think the problem is the readability of \"file\" when in fact the real error has nothing to do with \"file\"."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.114,
            0.312,
            0.335,
            0.328
          ],
          "content": [
            {
              "type": "text",
              "content": "A better way to write the above is"
            }
          ]
        },
        {
          "type": "code",
          "index": 6,
          "bbox": [
            0.113,
            0.336,
            0.424,
            0.396
          ],
          "content": [
            {
              "type": "code_body",
              "index": 6,
              "bbox": [
                0.113,
                0.336,
                0.424,
                0.396
              ],
              "content": "try:\n    foo = opne(\"file\")\nexcept IOError:\n    sys.exit(\"could not open file\")"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.112,
            0.409,
            0.885,
            0.44
          ],
          "content": [
            {
              "type": "text",
              "content": "When this is run, Python will produce a traceback showing the NameError, and it will be immediately apparent what needs to be fixed."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.112,
            0.447,
            0.886,
            0.54
          ],
          "content": [
            {
              "type": "text",
              "content": "Because except: catches all exceptions, including SystemExit, KeyboardInterrupt, and GeneratorExit (which is not an error and should not normally be caught by user code), using a bare except: is almost never a good idea. In situations where you need to catch all “normal” errors, such as in a framework that runs callbacks, you can catch the base class for all normal exceptions, Exception. Unfortunately in Python 2.x it is possible for third-party code to raise exceptions that do not inherit from Exception, so in Python 2.x there are some cases where you may have to use a bare except: and manually re-raise the exceptions you don’t want to catch."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 9,
          "bbox": [
            0.114,
            0.568,
            0.271,
            0.59
          ],
          "content": [
            {
              "type": "text",
              "content": "2 Exceptions"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.112,
            0.61,
            0.885,
            0.641
          ],
          "content": [
            {
              "type": "text",
              "content": "Exceptions are a useful feature of Python. You should learn to raise them whenever something unexpected occurs, and catch them only where you can do something about them."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.114,
            0.647,
            0.39,
            0.664
          ],
          "content": [
            {
              "type": "text",
              "content": "The following is a very popular anti-idiom"
            }
          ]
        },
        {
          "type": "code",
          "index": 12,
          "bbox": [
            0.113,
            0.673,
            0.399,
            0.746
          ],
          "content": [
            {
              "type": "code_body",
              "index": 12,
              "bbox": [
                0.113,
                0.673,
                0.399,
                0.746
              ],
              "content": "def get_status(file):\n    if not os.path.exists(file):\n        print \"file not found\"\n        sys.exit(1)\n    return open(file).readline()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.112,
            0.759,
            0.886,
            0.837
          ],
          "content": [
            {
              "type": "text",
              "content": "Consider the case where the file gets deleted between the time the call to os.path.exists() is made and the time open() is called. In that case the last line will raise an IOError. The same thing would happen if file exists but has no read permission. Since testing this on a normal machine on existent and non-existent files makes it seem bugless, the test results will seem fine, and the code will get shipped. Later an unhandled IOError (or perhaps some other EnvironmentError) escapes to the user, who gets to watch the ugly traceback."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.114,
            0.842,
            0.368,
            0.858
          ],
          "content": [
            {
              "type": "text",
              "content": "Here is a somewhat better way to do it."
            }
          ]
        },
        {
          "type": "page_number",
          "index": 15,
          "bbox": [
            0.494,
            0.936,
            0.506,
            0.948
          ],
          "content": [
            {
              "type": "text",
              "content": "4"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 4,
      "blocks": [
        {
          "type": "code",
          "index": 0,
          "bbox": [
            0.114,
            0.098,
            0.565,
            0.185
          ],
          "content": [
            {
              "type": "code_body",
              "index": 0,
              "bbox": [
                0.114,
                0.098,
                0.565,
                0.185
              ],
              "content": "def get_status(file):\n    try:\n        return open(file).readline()\n    except EnvironmentError as err:\n        print \"Unable to open file: {}\".format(err)\n        sys.exit(1)"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.113,
            0.198,
            0.885,
            0.231
          ],
          "content": [
            {
              "type": "text",
              "content": "In this version, either the file gets opened and the line is read (so it works even on flaky NFS or SMB connections), or an error message is printed that provides all the available information on why the open failed, and the application is aborted."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.112,
            0.236,
            0.885,
            0.269
          ],
          "content": [
            {
              "type": "text",
              "content": "However, even this version of get_status() makes too many assumptions — that it will only be used in a short running script, and not, say, in a long running server. Sure, the caller could do something like"
            }
          ]
        },
        {
          "type": "code",
          "index": 3,
          "bbox": [
            0.114,
            0.277,
            0.362,
            0.336
          ],
          "content": [
            {
              "type": "code_body",
              "index": 3,
              "bbox": [
                0.114,
                0.277,
                0.362,
                0.336
              ],
              "content": "try:\n    status = get_status(log)\nexcept SystemExit:\n    status = None"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.113,
            0.35,
            0.885,
            0.381
          ],
          "content": [
            {
              "type": "text",
              "content": "But there is a better way. You should try to use as few except clauses in your code as you can — the ones you do use will usually be inside calls which should always succeed, or a catch-all in a main function."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.114,
            0.387,
            0.498,
            0.403
          ],
          "content": [
            {
              "type": "text",
              "content": "So, an even better version of get_status() is probably"
            }
          ]
        },
        {
          "type": "code",
          "index": 6,
          "bbox": [
            0.114,
            0.413,
            0.397,
            0.443
          ],
          "content": [
            {
              "type": "code_body",
              "index": 6,
              "bbox": [
                0.114,
                0.413,
                0.397,
                0.443
              ],
              "content": "def get_status(file):\n    return open(file).readline()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.114,
            0.457,
            0.884,
            0.489
          ],
          "content": [
            {
              "type": "text",
              "content": "The caller can deal with the exception if it wants (for example, if it tries several files in a loop), or just let the exception filter upwards to its caller."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.113,
            0.495,
            0.885,
            0.542
          ],
          "content": [
            {
              "type": "text",
              "content": "But the last version still has a serious problem — due to implementation details in CPython, the file would not be closed when an exception is raised until the exception handler finishes; and, worse, in other implementations (e.g., Jython) it might not be closed at all regardless of whether or not an exception is raised."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.548,
            0.885,
            0.579
          ],
          "content": [
            {
              "type": "text",
              "content": "The best version of this function uses the open() call as a context manager, which will ensure that the file gets closed as soon as the function returns:"
            }
          ]
        },
        {
          "type": "code",
          "index": 10,
          "bbox": [
            0.114,
            0.589,
            0.362,
            0.633
          ],
          "content": [
            {
              "type": "code_body",
              "index": 10,
              "bbox": [
                0.114,
                0.589,
                0.362,
                0.633
              ],
              "content": "def get_status(file):\n    with open(file) as fp:\n        return fp.readline()"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.114,
            0.669,
            0.36,
            0.691
          ],
          "content": [
            {
              "type": "text",
              "content": "3 Using the Batteries"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.112,
            0.712,
            0.885,
            0.758
          ],
          "content": [
            {
              "type": "text",
              "content": "Every so often, people seem to be writing stuff in the Python library again, usually poorly. While the occasional module has a poor interface, it is usually much better to use the rich standard library and data types that come with Python than inventing your own."
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.112,
            0.765,
            0.885,
            0.796
          ],
          "content": [
            {
              "type": "text",
              "content": "A useful module very few people know about is os.path. It always has the correct path arithmetic for your operating system, and will usually be much better than whatever you come up with yourself."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.115,
            0.802,
            0.184,
            0.818
          ],
          "content": [
            {
              "type": "text",
              "content": "Compare:"
            }
          ]
        },
        {
          "type": "code",
          "index": 15,
          "bbox": [
            0.114,
            0.827,
            0.38,
            0.886
          ],
          "content": [
            {
              "type": "code_body",
              "index": 15,
              "bbox": [
                0.114,
                0.827,
                0.38,
                0.886
              ],
              "content": "# ugh!\nreturn dir�\"/\"+file\n# better\nreturn os.path.join(dir, file)"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "page_number",
          "index": 16,
          "bbox": [
            0.494,
            0.935,
            0.506,
            0.949
          ],
          "content": [
            {
              "type": "text",
              "content": "5"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 5,
      "blocks": [
        {
          "type": "text",
          "index": 0,
          "bbox": [
            0.114,
            0.092,
            0.684,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "More useful functions in os.path: basename(), dirname() and splitext()."
            }
          ]
        },
        {
          "type": "text",
          "index": 1,
          "bbox": [
            0.112,
            0.115,
            0.885,
            0.177
          ],
          "content": [
            {
              "type": "text",
              "content": "There are also many useful built-in functions people seem not to be aware of for some reason: min() and max() can find the minimum/maximum of any sequence with comparable semantics, for example, yet many people write their own max()/min(). Another highly useful function is reduce() which can be used to repeatedly apply a binary operation to a sequence, reducing it to a single value. For example, compute a factorial with a series of multiply operations:"
            }
          ]
        },
        {
          "type": "code",
          "index": 2,
          "bbox": [
            0.113,
            0.185,
            0.459,
            0.244
          ],
          "content": [
            {
              "type": "code_body",
              "index": 2,
              "bbox": [
                0.113,
                0.185,
                0.459,
                0.244
              ],
              "content": ">>> n = 4\n>>> import operator\n>>> reduce(operator.mul, range(1, n+1))\n24"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.113,
            0.257,
            0.884,
            0.29
          ],
          "content": [
            {
              "type": "text",
              "content": "When it comes to parsing numbers, note that float(), int() and long() all accept string arguments and will reject ill-formed strings by raising an ValueError."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 4,
          "bbox": [
            0.114,
            0.318,
            0.606,
            0.34
          ],
          "content": [
            {
              "type": "text",
              "content": "4 Using Backslash to Continue Statements"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.113,
            0.36,
            0.885,
            0.391
          ],
          "content": [
            {
              "type": "text",
              "content": "Since Python treats a newline as a statement terminator, and since statements are often more than is comfortable to put in one line, many people do:"
            }
          ]
        },
        {
          "type": "code",
          "index": 6,
          "bbox": [
            0.113,
            0.4,
            0.585,
            0.446
          ],
          "content": [
            {
              "type": "code_body",
              "index": 6,
              "bbox": [
                0.113,
                0.4,
                0.585,
                0.446
              ],
              "content": "if foo.bar()['first'][0] == baz.quux(1, 2)[5:9] and \\\n    calculate_number(10, 20) != forbulate(500, 360):\n        pass"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.113,
            0.46,
            0.885,
            0.491
          ],
          "content": [
            {
              "type": "text",
              "content": "You should realize that this is dangerous: a stray space after the \\ would make this line wrong, and stray spaces are notoriously hard to see in editors. In this case, at least it would be a syntax error, but if the code was:"
            }
          ]
        },
        {
          "type": "code",
          "index": 8,
          "bbox": [
            0.114,
            0.5,
            0.591,
            0.53
          ],
          "content": [
            {
              "type": "code_body",
              "index": 8,
              "bbox": [
                0.114,
                0.5,
                0.591,
                0.53
              ],
              "content": "value = foo.bar()['first'][0]*baz.quux(1, 2)[5:9] \\\n+ calculate_number(10, 20)*forbulate(500, 360)"
            }
          ],
          "sub_type": "code",
          "guess_lang": "javascript"
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.115,
            0.545,
            0.338,
            0.56
          ],
          "content": [
            {
              "type": "text",
              "content": "then it would just be subtly wrong."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.114,
            0.567,
            0.596,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "It is usually much better to use the implicit continuation inside parenthesis:"
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.115,
            0.59,
            0.291,
            0.605
          ],
          "content": [
            {
              "type": "text",
              "content": "This version is bulletproof:"
            }
          ]
        },
        {
          "type": "code",
          "index": 12,
          "bbox": [
            0.113,
            0.615,
            0.599,
            0.646
          ],
          "content": [
            {
              "type": "code_body",
              "index": 12,
              "bbox": [
                0.113,
                0.615,
                0.599,
                0.646
              ],
              "content": "value = (foo.bar()['first'][0]*baz.quux(1, 2)[5:9]\n            + calculate_number(10, 20)*forbulate(500, 360))"
            }
          ],
          "sub_type": "code",
          "guess_lang": "python"
        },
        {
          "type": "page_number",
          "index": 13,
          "bbox": [
            0.494,
            0.935,
            0.506,
            0.949
          ],
          "content": [
