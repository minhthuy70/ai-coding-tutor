# ============================================================
# Environment Variables Example for AI-Powered Coding Tutor
# ============================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=ai_coding_tutor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis Cache / Celery Broker ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/ai_coding_tutor
SECRET_KEY=change-this-to-a-secure-random-secret-key
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI Engine Configuration ---
AI_PROVIDER=gemini # Options: gemini, openai, ollama
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Optional AI Fallback & Local Models ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# --- ChromaDB Vector Database (RAG) ---
CHROMA_DB_DIR=./backend/chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
