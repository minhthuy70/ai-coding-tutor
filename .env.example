# ============================================================
# Environment Variables Example for AI-Powered Coding Tutor
# ============================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=ai_coding_tutor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis Cache / Broker ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/ai_coding_tutor
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
